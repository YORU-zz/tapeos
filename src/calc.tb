/* calc.tb - TinyBASIC sample: operators, control
   structures, arrays, char semantics. Every result is
   written as a word at 0E688h + 2*i (see tinybasic.md
   for the expected values) under the "TBRS" signature
   with tag 2. The interpreter must produce exactly the
   same signature as the compiler. */

dim int sq(16)
int gsum

func void pw(int i, int v)
    poke(0xE688 + i + i, v & 255)
    poke(0xE689 + i + i, (v >> 8) & 255)
endfunc

func int addg(int x)
    gsum = gsum + x
    return gsum
endfunc

func int Main()
    int i, j, s, f, r
    char c
    /* 0: for loop, sum 1..100 = 5050 */
    s = 0
    for i = 1 to 100
        s = s + i
    next
    pw(0, s)
    /* 1: while loop, sum of evens 2..50 = 650 */
    s = 0
    i = 2
    while i <= 50
        s = s + i
        i = i + 2
    endwhile
    pw(1, s)
    /* 2: repeat-until, 6! = 720 */
    f = 1
    i = 1
    repeat
        f = f * i
        i = i + 1
    until i > 6
    pw(2, f)
    /* 3: break: first i with i*i > 50 is 8 */
    r = 0
    for i = 0 to 100
        if i * i > 50 then
            r = i
            break
        endif
    next
    pw(3, r)
    /* 4: global array of squares, sum = 1240 */
    s = 0
    for i = 0 to 15
        sq(i) = i * i
        s = s + sq(i)
    next
    pw(4, s)
    /* 5: bitwise: 28 + 62 + 34 + 40 = 164 */
    pw(5, (0x3C & 0x1E) + (0x3C | 0x1E) + (0x3C ^ 0x1E) + (5 << 3))
    /* 6: arithmetic shift right: -256 >> 4 = -16 */
    pw(6, (0 - 256) >> 4)
    /* 7: div/mod signs: -3 + -2*4 + -3*16 + 2*64 = 69 */
    pw(7, (0 - 17) / 5 + ((0 - 17) % 5) * 4 + (17 / (0 - 5)) * 16 + (17 % (0 - 5)) * 64)
    /* 8: comparisons as values = 219 (the last one
       overflows a naive 16-bit subtraction: 20000 - -20000) */
    pw(8, (3 < 5) * 1 + (5 <= 5) * 2 + (7 > 9) * 4 + (7 >= 7) * 8 + (4 == 4) * 16 + (4 != 4) * 32 + ((0 - 3) < (0 - 2)) * 64 + (20000 > (0 - 20000)) * 128)
    /* 9: char truncation: 200 + 100 stored in a char = 44 */
    c = 200
    c = c + 100
    pw(9, c)
    /* 10: logical operators = 10 */
    pw(10, (1 && 0) * 1 + (1 || 0) * 2 + (!5) * 4 + (!0) * 8)
    /* 11: nested loops: (1+2+3+4)^2 = 100 */
    s = 0
    for i = 1 to 4
        for j = 1 to 4
            s = s + i * j
        next
    next
    pw(11, s)
    /* 12: for with negative step: 10+8+6+4+2 = 30 */
    s = 0
    for i = 10 to 2 step -2
        s = s + i
    next
    pw(12, s)
    /* 13: global scalar shared across functions = 3+4 */
    gsum = 0
    r = addg(3)
    r = addg(4)
    pw(13, r)
    /* 14: precedence mix: -6 + 2 + 1 - 1 = -4 */
    pw(14, (0 - 2) * 3 + 10 / 4 - (0 - 1) + 0 - 1)
    /* signature header */
    poke(0xE680, 0x54)
    poke(0xE681, 0x42)
    poke(0xE682, 0x52)
    poke(0xE683, 0x53)
    poke(0xE684, 2)
    print("CALC DONE")
    print()
    return 0
endfunc
