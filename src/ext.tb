/* ext.tb - TinyBASIC sample: external functions.
   cls / locate / print / input / peek / poke / putc.
   The session types "123" for the input() call.
   Signature "TBRS" tag 3; word 0 = the input value,
   word 1 = the peeked byte (0A5h = 165). */

func int Main()
    int v, b
    cls()
    locate(5, 3)
    print("EXT TEST")
    print()
    print("N?")
    v = input()
    print("GOT ")
    print(v)
    print()
    poke(0xE690, 0xA5)
    b = peek(0xE690)
    putc(65)
    print()
    poke(0xE680, 0x54)
    poke(0xE681, 0x42)
    poke(0xE682, 0x52)
    poke(0xE683, 0x53)
    poke(0xE684, 3)
    poke(0xE688, v & 255)
    poke(0xE689, (v >> 8) & 255)
    poke(0xE68A, b & 255)
    poke(0xE68B, (b >> 8) & 255)
    return 0
endfunc
