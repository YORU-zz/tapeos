; disasm.z80 - DISASM: a standalone Z80 disassembler
; for TapeOS (X1). OUROBO/ROS reproduction project
; (P2), roadmap item 59: stage 1 of the disassembler /
; decompile pipeline (work wish 31), built standalone
; first (the novel's order - EDAS built-in first, split
; out later - is reversed on the reproduction side by
; user decision, 2026-11-24).
;
; DISASM is a TOSD program (load 0x4000). It disassembles
; either a TOSD file (with a user-given load address) or
; a memory range, and writes source that NEWASM / EDAS
; (and host pasmo) re-assemble byte-identically:
;
;   - full Z80 decode: base map, CB, ED, DD, FD and
;     DDCB/FDCB forms, via the structured x/y/z decode
;   - labels are generated for in-range control-flow
;     targets (JP / JR / CALL / DJNZ); out-of-range
;     targets and data addresses print as numbers
;   - code/data separation is by user-given DATA
;     ranges only (no auto detection)
;
; Policy for encodings whose mnemonic form does not
; re-assemble to the same bytes under NEWASM/EDAS -
; undefined opcodes, undocumented IXH/IXL/IYH/IYL
; forms, DDCB copy forms, alternate encodings
; (ED 63 / ED 6B), and any DD/FD prefix the following
; instruction does not consume (doubled prefixes,
; prefixes before ED/CB forms, and prefixes before
; instructions with no index-register operand): the
; offending byte is emitted as DB and decoding
; resynchronises at the next byte. Every emitted item
; is therefore either a canonical instruction or a
; DB, so the output always re-assembles
; byte-identically.
;
; Memory map (the EDAS zone 0x4000-0x7FFF):
;   04000h..        this program (code + data)
;   06800h          DIRBUF (own directory sector copy)
;   06900h          SECBUF (input sector cache)
;   06a00h          OUTBUF (output sector buffer)
;   06b00h          INBUF  (prompt input line)
;   06b80h          LINEBUF (output line assembly)
;   06c00h..073ffh  LABTAB (sorted label targets,
;                   up to 1024 x LE16)
;   07400h..07bffh  FDBITS (forced-DB bitset, one bit
;                   per input offset, range <= 16 KiB)
;   07c00h          DRTAB (data ranges, 16 x 4 bytes)
;
; Status block at 0xE640 (as in SCC/SCI):
;   +0 "DIS", +3 status (0FFh = running, 0 = OK,
;   else error code), +4..5 input bytes, +6..7
;   output bytes (low word).

        org     04000h

; ---- IOCS entries (X1 table at 0xE400) ----
C_CONOUT        equ     0e406h
C_PRTMSG        equ     0e409h
C_CRLF          equ     0e40ch
C_GETLIN        equ     0e40fh
C_DREAD         equ     0e42dh
C_DWRITE        equ     0e430h

; ---- constants ----
DIRREC          equ     32              ; directory record
FDMAXREC        equ     1280            ; FD records (320 KB)
DIRBUF          equ     06800h
SECBUF          equ     06900h
OUTBUF          equ     06a00h
INBUF           equ     06b00h
LINEBUF         equ     06b80h
LABTAB          equ     06c00h
LABMAX          equ     1024
FDBITS          equ     07400h
DRTAB           equ     07c00h
DRMAX           equ     16
RANGEMAX        equ     16384           ; input range cap
STBLK           equ     0e640h
WORKTOP         equ     07c40h          ; memory-mode guard

; ---- error codes ----
E_BIG           equ     6               ; too big (house codes)
E_FILE          equ     7               ; file error (house)
E_RANGE         equ     20              ; bad / overlapping range
E_LAB           equ     21              ; too many labels
E_NUM           equ     22              ; bad number
E_DR            equ     23              ; too many data ranges
E_DIR           equ     24              ; directory full

; ---------------------------------------------------------------
; Entry. The shell's G command lands here (04000h).
; ---------------------------------------------------------------
        jp      start

start:
        ld      (saved_sp), sp
        ld      hl, STBLK
        ld      (hl), 'D'
        inc     hl
        ld      (hl), 'I'
        inc     hl
        ld      (hl), 'S'
        inc     hl
        ld      (hl), 0ffh              ; running
        ; clear state
        xor     a
        ld      (dr_cnt), a
        ld      (lab_cnt), a
        ld      (lab_cnt + 1), a
        ld      (src_mode), a
        ld      (out_mode), a
        ld      hl, 0
        ld      (out_len), hl
        ld      (out_len + 2), hl
        ld      hl, 0ffffh
        ld      (cache_rec), hl
        ld      hl, msg_banner
        call    C_PRTMSG
        ; ---- SRC prompt ----
        ld      hl, msg_srcp
        call    C_PRTMSG
        call    read_line
        or      a
        jr      z, src_mem              ; empty: memory mode
        ld      hl, INBUF
        ld      de, name_src
        call    name_copy
        ; find the file
        call    dir_load
        ld      hl, name_src
        ld      (find_name), hl
        call    find_entry
        ld      a, E_FILE
        jp      c, err                  ; not found
        ld      de, 10
        add     hl, de
        ld      e, (hl)
        inc     hl
        ld      d, (hl)                 ; start record
        ld      (src_rec0), de
        inc     hl
        ld      e, (hl)
        inc     hl
        ld      d, (hl)                 ; size
        ld      (src_size), de
        xor     a
        ld      (src_mode), a           ; file mode
        ; ---- BASE prompt ----
        ld      hl, msg_basep
        call    C_PRTMSG
        call    read_line
        or      a
        ld      a, E_NUM
        jp      z, err                  ; base is required
        call    parse_hex_line
        ld      (src_base), hl
        jr      src_range_ok
src_mem:
        ld      a, 1
        ld      (src_mode), a           ; memory mode
        ld      hl, msg_fromp
        call    C_PRTMSG
        call    read_line
        or      a
        ld      a, E_NUM
        jp      z, err
        call    parse_hex_line
        ld      (src_base), hl
        ld      hl, msg_top
        call    C_PRTMSG
        call    read_line
        or      a
        ld      a, E_NUM
        jp      z, err
        call    parse_hex_line          ; HL = TO (inclusive)
        ld      de, (src_base)
        or      a
        sbc     hl, de                  ; TO - FROM
        ld      a, E_RANGE
        jp      c, err                  ; TO < FROM
        inc     hl                      ; size = TO-FROM+1
        ld      (src_size), hl
        ; memory range must not overlap the work zone
        ld      hl, (src_base)
        ld      de, WORKTOP
        or      a
        sbc     hl, de
        jr      nc, src_range_ok        ; base >= WORKTOP: fine
        ld      hl, (src_base)
        ld      de, (src_size)
        add     hl, de                  ; end (exclusive)
        ld      de, 04000h
        or      a
        sbc     hl, de
        ld      a, E_RANGE
        jp      nc, err                 ; end > 0x4000: overlap
src_range_ok:
        ; range size cap (16 KiB)
        ld      hl, (src_size)
        ld      de, RANGEMAX + 1
        or      a
        sbc     hl, de
        ld      a, E_BIG
        jp      nc, err
        ; ---- DATA range prompts ----
data_lp:
        ld      hl, msg_datap
        call    C_PRTMSG
        call    read_line
        or      a
        jr      z, data_done
        call    parse_range_line        ; -> dr_lo, dr_hi
        ld      a, (dr_cnt)
        cp      DRMAX
        ld      a, E_DR
        jp      nc, err
        ld      a, (dr_cnt)
        add     a, a
        add     a, a
        ld      e, a
        ld      d, 0
        ld      hl, DRTAB
        add     hl, de
        ld      de, (dr_lo)
        ld      (hl), e
        inc     hl
        ld      (hl), d
        inc     hl
        ld      de, (dr_hi)
        ld      (hl), e
        inc     hl
        ld      (hl), d
        ld      hl, dr_cnt
        inc     (hl)
        jr      data_lp
data_done:
        ; ---- OUT prompt ----
        ld      hl, msg_outp
        call    C_PRTMSG
        call    read_line
        or      a
        jr      z, out_screen
        ld      hl, INBUF
        ld      de, name_out
        call    name_copy
        ; OUT must differ from SRC (file mode)
        ld      a, (src_mode)
        or      a
        jr      nz, out_open
        ld      hl, name_src
        ld      de, name_out
        ld      b, 10
cmp_nm:
        ld      a, (de)
        cp      (hl)
        ld      a, E_FILE
        jp      nz, cmp_nm_ok           ; different: fine
        inc     hl
        inc     de
        djnz    cmp_nm
        ld      a, E_FILE               ; identical names
        jp      err
cmp_nm_ok:
        xor     a                       ; (fall through)
out_open:
        ld      a, 1
        ld      (out_mode), a
        call    out_open_file
        jr      run_passes
out_screen:
        xor     a
        ld      (out_mode), a
run_passes:
        call    pass1
        call    pass15
        call    pass2
        ld      a, (out_mode)
        or      a
        call    nz, out_close_file
        ; ---- status: OK ----
        ld      hl, STBLK + 3
        ld      (hl), 0
        inc     hl
        ld      de, (src_size)
        ld      (hl), e
        inc     hl
        ld      (hl), d
        inc     hl
        ld      de, (out_len)
        ld      (hl), e
        inc     hl
        ld      (hl), d
        ld      hl, msg_ok
        call    C_PRTMSG
        ld      hl, (out_len)
        call    print_dec
        ld      hl, msg_bytes
        call    C_PRTMSG
        ld      sp, (saved_sp)
        ret

; err: A = error code. Prints "ERR n", records the
; status block, and returns to the shell.
err:
        ld      (err_code), a
        ld      hl, STBLK + 3
        ld      (hl), a
        ld      hl, msg_err
        call    C_PRTMSG
        ld      a, (err_code)
        ld      l, a
        ld      h, 0
        call    print_dec
        call    C_CRLF
        ld      sp, (saved_sp)
        ret

; read_line: GETLIN into INBUF; returns A = length.
; ---------------------------------------------------------------
; Shared layers (roadmap item 60): the utility layer and the
; decode core live in tapeos/src/ and are shared verbatim
; with the EDAS disassembler module EDIS (tapeos/src/edis.z80).
; Assemble from the tree root (INCLUDE is CWD-relative).
; ---------------------------------------------------------------
        include "src/disasm_util.inc"
        include "src/disasm_core.inc"

        end
