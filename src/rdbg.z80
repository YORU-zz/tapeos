; rdbg.z80 - RDBG: a standalone, relocatable debugger
; for TapeOS (X1 first target). OUROBO/ROS reproduction
; project (P2), roadmap item 30: the debugger of
; episodes 26/29 - in the novel's relocation order
; (a) new assembler, (b) self-relocation, (c) debugger,
; this is step (c). Its prototype is EDAS's debugger
; function; the capture / breakpoint / ESC machinery
; follows the design proven by the resident debug stub
; (tapeos/src/dbgstub.inc, a separate program that is
; NOT modified - the two coexist: the stub lives in the
; monitor, RDBG is a loadable TOSD program).
;
; RDBG is a TOSR file (format v1) with the stage-1
; self-relocation stub: it runs at any page-aligned
; address the shell's R command loads it to. The stub
; finds its own image by the trailer marker + checksum
; and patches the marked high bytes by the page delta.
; The relocation bitmap is built host-side by
; tools/mkrdbg.py from a multi-ORG assembly diff (the
; roadmap-50 technique), so no mark is declared by
; hand. One deliberate deviation from the stage-1
; demo stub: the origin page is read from the trailer
; instead of an immediate, so the body carries no
; origin-dependent byte outside the marked operands.
;
; Commands (one letter, hex addresses):
;   D [addr]    dump 128 bytes (default: continue)
;   M addr b..  deposit bytes
;   R           show captured registers
;   B [addr]    set one-shot RST 30H breakpoint /
;               no argument clears it (the original
;               byte is always restored)
;   G [addr]    run fresh at addr (RET returns to
;               RDBG); no argument = continue
;   C           continue from the captured PC
;   L name      load a TOSD file to its directory
;               load address and set a fresh context
;               (PC = load address), ready for G / C
;   U [addr]    disassemble 96 bytes of live memory
;               with the shared DISASM/EDIS decode
;               core (src/disasm_core.inc - the same
;               source, no second implementation);
;               default: continue from the last U
;   Q           quit to the shell (page-0 vectors
;               and any breakpoint byte restored)
;   ?           help
;
; While a target runs under G/C the sub-CPU key
; interrupt (command 0E4h, vector 38h, IM 1) is armed:
; ESC captures every register and stops in RDBG
; (post-mortem), any other key is forwarded into the
; shell's keyboard ring so the target still receives
; it. The vector is disarmed whenever RDBG itself has
; control. Limits (as with any stub of this class): a
; target that executes DI gives up ESC until it EIs or
; hits a breakpoint; DI+HALT needs a reset; a target
; that rewrites page 0 or overwrites RDBG defeats it.
;
; Entry / exit mechanics: RDBG takes over the page-0
; vectors 0030h (RST 30H), 0038h (IM 1) and 0066h
; (NMI) while it runs, saving the monitor's bytes
; (which point at the resident stub) and restoring
; them on Q - so the resident stub works again
; immediately after RDBG exits.
;
; Memory map:
;   body            this image (code + strings, then
;                   the shared core, then work areas:
;                   INBUF / LINEBUF / save area /
;                   private stack), placed anywhere
;   0E640h          status mirror (house convention,
;                   as in DISASM / SCC): +0 "RDB",
;                   +3 last status (0FFh = starting,
;                   0 = OK, else error code), +4..5
;                   captured PC at the last stop,
;                   +6..7 captured HL, +8 stop reason
;                   (B/I/R), +9 own placement page,
;                   +10..11 next U address, +12..13
;                   U output length (chars), +14..15
;                   breakpoint address, +16 BP armed
;   0ED00h          SECBUF (256-aligned scratch; the
;                   shared core's file paths are not
;                   used, L stages its final partial
;                   record here)
;   0EE00h          DIRBUF (own directory sector)
;   0EF00h          LABTAB (512 labels x 2 bytes)
;   0F300h          FDBITS (forced-DB bitset)
;   0F400h          DRTAB (data ranges, unused by U:
;                   dr_cnt is always 0)
; The fixed scratch areas sit in the free zone the
; resident stub also uses (0E900h-0FFFFh); their
; contents are transient. The shell keyboard ring
; addresses (KBBUF/KBHEAD/KBTAIL/KBPREV) and STACKTOP
; are the X1 monitor's published source constants
; (tapeos/src/machine_x1.inc) - RDBG depends on them
; exactly as the resident stub does.
;
; Assemble from the tree root (the shared
; sources are included by relative path).
; Build with tools/mkrdbg.py (multi-ORG diff).

        include "build/rdbgdef.inc"       ; ORGADDR,
                                        ; BODY_SIZE,
                                        ; TOTAL_SIZE
                                        ; (generated by
                                        ; mkrdbg.py)

        org     ORGADDR

; ---- IOCS entries (X1 table at 0xE400) ----
C_CONOUT        equ     0e406h
C_PRTMSG        equ     0e409h
C_CRLF          equ     0e40ch
C_GETLIN        equ     0e40fh
C_DREAD         equ     0e42dh
C_DWRITE        equ     0e430h

; ---- X1 monitor constants (machine_x1.inc) ----
STACKTOP        equ     0e000h
SUBCPU          equ     01900h          ; 80C49 data port
PPIB            equ     01a01h          ; 8255 port B
KBBUF           equ     0e340h          ; 16-byte key ring
KBHEAD          equ     0e350h
KBTAIL          equ     0e351h
KBPREV          equ     0e352h

; ---- fixed scratch for the shared core / L ----
DIRREC          equ     32              ; directory record
FDMAXREC        equ     1280            ; FD records
SECBUF          equ     0ed00h          ; 256-aligned
OUTBUF          equ     0ed00h          ; (file-out unused)
DIRBUF          equ     0ee00h
LABTAB          equ     0ef00h
LABMAX          equ     512
FDBITS          equ     0f300h
DRTAB           equ     0f400h
DRMAX           equ     16
RANGEMAX        equ     2048            ; input cap (FDBITS size)

; ---- status mirror (fixed) ----
MIRBLK          equ     0e640h
MIR_PAGE        equ     MIRBLK + 9

; ---- constants ----
UWIND           equ     96              ; U window bytes

; ---- error codes (same as DISASM / EDIS) ----
E_BIG           equ     6
E_FILE          equ     7
E_RANGE         equ     20
E_LAB           equ     21
E_NUM           equ     22
E_DR            equ     23
E_DIR           equ     24

; ===============================================================
; Self-relocation stub (stage-1 design; position
; independent, no byte of it is ever marked). The
; origin page is read from the trailer (+4) rather
; than held as an immediate.
; ===============================================================
stub:
        ld      b, 0                    ; page counter
        ld      hl, 0                   ; candidate base
stub_find:
        push    hl
        ld      de, TOTAL_SIZE-16
        add     hl, de                  ; -> candidate trailer
        ld      a, (hl)
        cp      054h                    ; 'T'
        jr      nz, stub_next
        inc     hl
        ld      a, (hl)
        cp      052h                    ; 'R'
        jr      nz, stub_next
        pop     hl                      ; HL = candidate base
        push    hl
        ld      bc, TOTAL_SIZE-2
        ld      de, 0                   ; DE = byte sum
stub_ck:
        ld      a, (hl)
        inc     hl
        add     a, e
        ld      e, a
        jr      nc, stub_ck2
        inc     d
stub_ck2:
        dec     bc
        ld      a, b
        or      c
        jr      nz, stub_ck
        ld      a, (hl)                 ; stored checksum low
        cp      e
        jr      nz, stub_next
        inc     hl                      ; stored checksum high
        ld      a, (hl)
        cp      d
        jr      nz, stub_next
        pop     hl                      ; HL = own base: FOUND
        jr      stub_located
stub_next:
        pop     hl
        inc     h                       ; next page
        inc     b
        jr      nz, stub_find
        jr      entry                   ; not found: run as-is
stub_located:
        ld      a, h                    ; own page
        ld      (MIR_PAGE), a           ; mirror (fixed addr)
        push    hl
        ld      de, TOTAL_SIZE-16+4
        add     hl, de                  ; -> trailer origin page
        ld      a, (hl)
        pop     hl
        ld      c, a                    ; C = origin page
        ld      a, h
        sub     c                       ; A = delta (signed)
        jr      z, entry                ; delta 0: pass through
        ld      c, a                    ; C = delta
        push    hl
        pop     ix                      ; IX = body cursor
        ld      de, BODY_SIZE
        add     hl, de
        push    hl
        pop     iy                      ; IY = bitmap cursor
        ld      de, BODY_SIZE           ; DE = bytes remaining
stub_byte:
        ld      a, (iy)
        inc     iy
        ld      h, a                    ; H = bitmap byte
        ld      b, 8                    ; 8 bits, MSB first
stub_bit:
        sla     h                       ; next bit -> carry
        jr      nc, stub_skip
        ld      a, (ix)
        add     a, c                    ; patch high byte += delta
        ld      (ix), a
stub_skip:
        inc     ix
        dec     de
        ld      a, d
        or      e
        jr      z, entry                ; done: fall into entry
        djnz    stub_bit
        jr      stub_byte

; ===============================================================
; Entry. The shell's G lands at the image start (the
; stub above); control falls here with the incoming
; SP still pointing at the shell's return address.
; ===============================================================
entry:
        ld      (saved_sp), sp          ; core var: shell SP
        ld      sp, sd_stack_top
        ; status mirror: signature + "starting"
        ld      hl, MIRBLK
        ld      (hl), 'R'
        inc     hl
        ld      (hl), 'D'
        inc     hl
        ld      (hl), 'B'
        inc     hl
        ld      (hl), 0ffh              ; +3 status: starting
        ; clear state
        xor     a
        ld      (sd_status), a
        ld      (sd_bps), a
        ld      (sd_runf), a
        ld      (sd_rsn), a
        ld      hl, sd_sv
        ld      b, 26
en_iclr:
        ld      (hl), a
        inc     hl
        djnz    en_iclr
        ld      hl, STACKTOP
        ld      (sd_sv+14), hl          ; sv SP
        ld      hl, 0
        ld      (sd_dptr), hl
        ld      (sd_uptr), hl
        ld      (MIRBLK+10), hl         ; U continuation
        ld      (MIRBLK+12), hl         ; U length
        ld      (MIRBLK+14), hl         ; BP address
        ld      (MIRBLK+16), a          ; BP armed = 0
        ld      (MIRBLK+8), a           ; stop reason = 0
        ld      (MIRBLK+4), hl          ; captured PC
        ld      (MIRBLK+6), hl          ; captured HL
        ; save the monitor's page-0 vectors (0030/0038/0066)
        ld      hl, 00030h
        ld      de, sd_vec_save
        ld      bc, 3
        ldir
        ld      hl, 00038h
        ld      de, sd_vec_save+3
        ld      bc, 3
        ldir
        ld      hl, 00066h
        ld      de, sd_vec_save+6
        ld      bc, 3
        ldir
        ; plant RDBG's vectors
        ld      a, 0c3h                 ; JP
        ld      (00030h), a
        ld      hl, s_bp
        ld      (00031h), hl
        ld      a, 0c3h
        ld      (00038h), a
        ld      hl, s_int
        ld      (00039h), hl
        ld      a, 0c3h
        ld      (00066h), a
        ld      hl, s_int
        ld      (00067h), hl
        call    sd_disarm               ; key vector off
        call    sd_drain                ; drop stale keys
        ld      hl, sd_banner
        call    C_PRTMSG
        jp      prompt

; ===============================================================
; Prompt / command dispatch. Input is the IOCS GETLIN
; (via the shared util's read_line); the prompt resets
; SP on entry, so error paths may jump here from any
; depth.
; ===============================================================
prompt:
        ld      sp, sd_stack_top
        ld      a, (sd_status)
        ld      (MIRBLK+3), a           ; publish status
        ld      hl, msg_prompt
        call    C_PRTMSG
        call    read_line               ; INBUF, A = length
        or      a
        jr      z, prompt               ; empty: re-prompt
        ld      hl, INBUF
        ld      (txtptr), hl
        call    skip_sp
        ld      hl, (txtptr)
        ld      a, (hl)
        inc     hl
        ld      (txtptr), hl
        call    upcase_a
        cp      'D'
        jp      z, c_d
        cp      'M'
        jp      z, c_m
        cp      'R'
        jp      z, c_r
        cp      'B'
        jp      z, c_b
        cp      'G'
        jp      z, c_g
        cp      'C'
        jp      z, c_c
        cp      'L'
        jp      z, c_l
        cp      'U'
        jp      z, c_u
        cp      'Q'
        jp      z, c_q
        cp      '?'
        jp      z, c_help
        ld      hl, msg_quest
        call    C_PRTMSG
        jr      prompt

cmd_done:
        xor     a
        ld      (sd_status), a
        jp      prompt

; upcase_a: A -> upper case if a lower-case letter.
upcase_a:
        cp      'a'
        ret     c
        cp      'z' + 1
        ret     nc
        sub     020h
        ret

; is_hexd: A = char -> carry set if a hex digit.
is_hexd:
        cp      '0'
        jr      c, ih_no
        cp      '9' + 1
        jr      c, ih_yes
        cp      'A'
        jr      c, ih_no
        cp      'F' + 1
        jr      c, ih_yes
        cp      'a'
        jr      c, ih_no
        cp      'f' + 1
        jr      nc, ih_no
ih_yes:
        scf
        ret
ih_no:
        or      a
        ret

; parse_opt: if a hex number follows at txtptr (after
; spaces), parse it and return carry set + HL = value;
; else return carry clear. A present-but-bad number
; cannot occur (the first character is checked).
parse_opt:
        call    skip_sp
        ld      hl, (txtptr)
        ld      a, (hl)
        call    is_hexd
        ret     nc
        call    parse_hex               ; util: -> HL
        scf
        ret

; ===============================================================
; D [addr]: dump 128 bytes.
; ===============================================================
c_d:
        call    parse_opt
        jr      nc, dd_def
        ld      (sd_dptr), hl
dd_def:
        ld      hl, (sd_dptr)
        ld      b, 8
dd_line:
        push    bc
        push    hl
        call    sd_hex16
        ld      a, ':'
        call    C_CONOUT
        pop     hl
        push    hl
        ld      b, 16
dd_b:
        ld      a, ' '
        call    C_CONOUT
        ld      a, (hl)
        call    sd_hex8
        inc     hl
        djnz    dd_b
        ld      a, ' '
        call    C_CONOUT
        pop     hl
        ld      b, 16
dd_a:
        ld      a, (hl)
        cp      020h
        jr      c, dd_dot
        cp      07fh
        jr      c, dd_ch
dd_dot:
        ld      a, '.'
dd_ch:
        call    C_CONOUT
        inc     hl
        djnz    dd_a
        call    C_CRLF
        pop     bc
        djnz    dd_line
        ld      (sd_dptr), hl
        jp      cmd_done

; ===============================================================
; M addr b..: deposit bytes.
; ===============================================================
c_m:
        call    parse_opt
        jr      nc, cm_bad
        ld      (sd_tmpw), hl
cm_lp:
        call    parse_opt
        jr      nc, cm_done
        ld      a, l                    ; low byte only
        push    hl
        ld      hl, (sd_tmpw)
        ld      (hl), a
        inc     hl
        ld      (sd_tmpw), hl
        pop     hl
        jr      cm_lp
cm_done:
        ld      hl, sd_okp
        call    C_PRTMSG
        jp      cmd_done
cm_bad:
        ld      hl, msg_quest
        call    C_PRTMSG
        jp      prompt

; ===============================================================
; R: register display.
; ===============================================================
c_r:
        call    print_regs
        jp      cmd_done

; print_regs: print the save area (also used by the
; stop report). Layout matches the resident stub:
; +0 IY +2 IX +4 HL +6 DE +8 BC +10 AF +12 PC +14 SP
; +16 AF' +18 BC' +20 DE' +22 HL' +24 I +25 IFF flags.
print_regs:
        ld      hl, r_pc
        ld      de, (sd_sv+12)
        call    sd_pf
        ld      hl, r_sp
        ld      de, (sd_sv+14)
        call    sd_pf
        ld      hl, r_af
        ld      de, (sd_sv+10)
        call    sd_pf
        ld      hl, r_bc
        ld      de, (sd_sv+8)
        call    sd_pf
        ld      hl, r_de
        ld      de, (sd_sv+6)
        call    sd_pf
        ld      hl, r_hl
        ld      de, (sd_sv+4)
        call    sd_pf
        call    C_CRLF
        ld      hl, r_ix
        ld      de, (sd_sv+2)
        call    sd_pf
        ld      hl, r_iy
        ld      de, (sd_sv+0)
        call    sd_pf
        ld      hl, r_saf
        ld      de, (sd_sv+16)
        call    sd_pf
        ld      hl, r_sbc
        ld      de, (sd_sv+18)
        call    sd_pf
        ld      hl, r_sde
        ld      de, (sd_sv+20)
        call    sd_pf
        ld      hl, r_shl
        ld      de, (sd_sv+22)
        call    sd_pf
        ld      hl, r_i
        call    C_PRTMSG
        ld      a, (sd_sv+24)
        call    sd_hex8
        call    C_CRLF
        ret
; sd_pf: print label at HL + hex16(DE) + ' '.
sd_pf:
        push    de
        call    C_PRTMSG
        pop     hl
        call    sd_hex16
        ld      a, ' '
        jp      C_CONOUT

; ===============================================================
; B [addr]: set / clear the one-shot breakpoint.
; ===============================================================
c_b:
        call    parse_opt
        jr      nc, cb_clear
        push    hl
        call    sd_unpatch              ; unpatch any old one
        pop     hl
        ld      (sd_bpa), hl
        ld      a, (hl)
        ld      (sd_bpb), a
        ld      a, 0f7h                 ; RST 30H
        ld      (hl), a
        ld      a, 1
        ld      (sd_bps), a
        ld      hl, (sd_bpa)
        ld      (MIRBLK+14), hl
        ld      a, 1
        ld      (MIRBLK+16), a
        ld      hl, msg_bp
        call    C_PRTMSG
        ld      hl, (sd_bpa)
        call    sd_hex16
        call    C_CRLF
        jp      cmd_done
cb_clear:
        call    sd_unpatch
        ld      hl, msg_bpoff
        call    C_PRTMSG
        jp      cmd_done
; sd_unpatch: restore the byte hidden by the patch.
sd_unpatch:
        ld      a, (sd_bps)
        or      a
        ret     z
        ld      hl, (sd_bpa)
        ld      a, (sd_bpb)
        ld      (hl), a
        xor     a
        ld      (sd_bps), a
        ld      (MIRBLK+16), a
        ret

; ===============================================================
; G [addr] / C: run / continue.
; ===============================================================
c_g:
        call    parse_opt
        jr      nc, c_c                 ; no arg: continue
        ; fresh context: all registers zero, PC = addr,
        ; SP = STACKTOP-2 with the return catcher planted,
        ; IFF2 forced on so a fresh run is ESC-breakable.
        push    hl
        xor     a
        ld      hl, sd_sv
        ld      b, 26
cg_clr:
        ld      (hl), a
        inc     hl
        djnz    cg_clr
        pop     hl
        ld      (sd_sv+12), hl          ; PC
        ld      hl, STACKTOP-2
        ld      (sd_sv+14), hl          ; SP
        ld      de, s_retcatch
        ld      (hl), e
        inc     hl
        ld      (hl), d
        ld      a, 004h
        ld      (sd_sv+25), a           ; IFF2 = 1
        ld      hl, msg_go
        call    C_PRTMSG
        ld      hl, (sd_sv+12)
        call    sd_hex16
        call    C_CRLF
        jp      resume
c_c:
        ld      hl, msg_cont
        call    C_PRTMSG
        ld      hl, (sd_sv+12)
        call    sd_hex16
        call    C_CRLF
        jp      resume

; fresh_ctx: shared by G-fresh and L: DE = entry
; address. Zeroes the save area, sets PC/SP/catcher/
; IFF2 as in c_g.
fresh_ctx:
        xor     a
        ld      hl, sd_sv
        ld      b, 26
fc_clr:
        ld      (hl), a
        inc     hl
        djnz    fc_clr
        ld      (sd_sv+12), de          ; PC = entry
        ld      hl, STACKTOP-2
        ld      (sd_sv+14), hl          ; SP
        ld      de, s_retcatch
        ld      (hl), e
        inc     hl
        ld      (hl), d
        ld      a, 004h
        ld      (sd_sv+25), a           ; IFF2 = 1
        ret

; ===============================================================
; resume: restore everything and RETI into the target.
; The key vector is armed first and the target always
; runs in IM 1; EI is the last step before RETI iff the
; captured IFF2 was set (the tail byte is patched) -
; the resident stub's proven discipline.
; ===============================================================
resume:
        ld      a, 038h
        call    sd_setvec               ; arm key interrupt
        im      1
        ld      a, (sd_sv+25)
        and     004h
        ld      a, 000h
        jr      z, rs_ei
        ld      a, 0fbh                 ; EI
rs_ei:
        ld      (sd_ei_slot), a
        ld      a, 1
        ld      (sd_runf), a
        ld      a, (sd_sv+24)
        ld      i, a                    ; I
        ld      hl, (sd_sv+16)          ; AF'
        push    hl
        ld      hl, (sd_sv+22)          ; HL'
        push    hl
        ld      hl, (sd_sv+20)          ; DE'
        push    hl
        ld      hl, (sd_sv+18)          ; BC' (top)
        push    hl
        exx
        ex      af, af'
        pop     bc
        pop     de
        pop     hl
        pop     af
        exx
        ex      af, af'
        ld      hl, (sd_sv+14)
        dec     hl
        dec     hl
        ld      (sd_sv+14), hl          ; SP slot for the PC
        ld      de, (sd_sv+12)
        ld      (hl), e
        inc     hl
        ld      (hl), d                 ; PC planted on stack
        ld      sp, sd_sv               ; save-area image:
        pop     iy                      ; IY IX HL DE BC AF
        pop     ix
        pop     hl
        pop     de
        pop     bc
        pop     af
        ld      sp, (sd_sv+14)
sd_ei_slot:
        nop                             ; patched to EI if IFF2
        reti

; ===============================================================
; Capture entries. s_bp: RST 30H vector (the stack
; holds the address after the patched byte). s_int:
; key interrupt, IM 1 vector (also NMI). s_retcatch:
; a fresh target RETurned here.
; ===============================================================
s_bp:
        ld      (sd_spraw), sp
        ld      sp, sd_stack_top
        push    af                      ; reason store must
        ld      a, 'B'                  ; not clobber A
        ld      (sd_rsn), a
        pop     af
        jr      cap_body
s_retcatch:
        ld      (sd_spraw), sp
        ld      sp, sd_stack_top
        push    af
        ld      a, 'R'
        ld      (sd_rsn), a
        pop     af
        jr      cap_body
s_int:
        ld      (sd_spraw), sp
        ld      sp, sd_stack_top
        push    af
        push    bc
        push    de
        push    hl
        call    sd_rd_txn               ; -> A = key code
        ld      (sd_key), a
        ld      a, (sd_runf)
        or      a
        jr      z, si_fwd
        ld      a, (sd_key)
        cp      01bh                    ; ESC?
        jr      z, si_stop
si_fwd:
        ; Not a break: forward the key into the shell's
        ; ring buffer (the kb_poll push logic), so a
        ; target polling KEYIN/INKEY still receives it.
        ld      a, (sd_key)
        or      a
        jr      z, si_ret
        ld      (KBPREV), a
        ld      a, (KBHEAD)
        inc     a
        and     00fh
        ld      c, a                    ; C = next head
        ld      a, (KBTAIL)
        cp      c
        jr      z, si_ret               ; ring full: drop
        ld      a, (KBHEAD)
        ld      hl, KBBUF
        ld      e, a
        ld      d, 0
        add     hl, de
        ld      a, (sd_key)
        ld      (hl), a
        ld      a, c
        ld      (KBHEAD), a
si_ret:
        pop     hl
        pop     de
        pop     bc
        pop     af
        ld      sp, (sd_spraw)
        ei                              ; this core re-enables
        reti                            ; via EI (see stub note)
si_stop:
        ld      a, 'I'
        ld      (sd_rsn), a
        pop     hl
        pop     de
        pop     bc
        pop     af
        jr      cap_body

; sd_rd_txn: read the interrupt-staged sub-CPU
; transaction. The core stages both bytes before
; raising the interrupt, so no waits are needed.
; First byte = function/flags (discarded), second =
; ASCII code -> A.
sd_rd_txn:
        push    bc
        ld      bc, SUBCPU
        in      a, (c)
        in      a, (c)
        pop     bc
        ret

; ===============================================================
; cap_body: capture every register into the save area.
; Entered with SP = RDBG stack and (sd_spraw) = the
; target SP, pointing at the pushed PC (breakpoint /
; interrupt) or just past the target's balanced stack
; (return catcher).
; ===============================================================
cap_body:
        push    af
        push    bc
        push    de
        push    hl
        push    ix
        push    iy
        ex      af, af'
        push    af                      ; shadow AF
        exx
        push    bc                      ; shadow BC
        push    de                      ; shadow DE
        push    hl                      ; shadow HL
        exx
        ex      af, af'
        call    sd_disarm               ; vector off while
                                        ; RDBG has control
        ; RDBG stack, top down: SHL SDE SBC SAF IY IX
        ; HL DE BC AF
        pop     hl
        ld      (sd_sv+22), hl          ; HL'
        pop     de
        ld      (sd_sv+20), de          ; DE'
        pop     bc
        ld      (sd_sv+18), bc          ; BC'
        pop     af
        push    af
        pop     hl
        ld      (sd_sv+16), hl          ; AF'
        pop     iy
        ld      (sd_sv+0), iy
        pop     ix
        ld      (sd_sv+2), ix
        pop     hl
        ld      (sd_sv+4), hl
        pop     de
        ld      (sd_sv+6), de
        pop     bc
        ld      (sd_sv+8), bc
        pop     af
        push    af
        pop     hl
        ld      (sd_sv+10), hl          ; AF
        ld      hl, (sd_spraw)
        ld      e, (hl)
        inc     hl
        ld      d, (hl)
        ld      (sd_sv+12), de          ; PC
        ld      hl, (sd_spraw)
        inc     hl
        inc     hl
        ld      (sd_sv+14), hl          ; SP before the push
        ld      a, i
        ld      (sd_sv+24), a           ; I
        push    af
        pop     hl
        ld      a, l
        ld      (sd_sv+25), a           ; LD A,I flags (bit2)
        ; reason-specific fixups
        ld      a, (sd_rsn)
        cp      'I'
        jr      z, cap_int
        cp      'B'
        jr      z, cap_bp
        cp      'R'
        jr      z, cap_ret
        jr      cap_done
cap_int:
        ; Interrupt delivery proves the target ran with
        ; interrupts enabled (the core's DI latch makes
        ; LD A,I read "disabled" here). Record IFF2 = 1
        ; so C resumes interruptible.
        ld      a, (sd_sv+25)
        or      004h
        ld      (sd_sv+25), a
        jr      cap_done
cap_bp:
        ld      hl, (sd_sv+12)
        dec     hl                      ; PC = patched byte
        ld      (sd_sv+12), hl
        call    sd_unpatch              ; restore + disarm
        jr      cap_done
cap_ret:
        ld      hl, (sd_spraw)
        ld      (sd_sv+14), hl          ; SP was balanced
        ld      hl, s_retcatch
        ld      (sd_sv+12), hl          ; PC = catcher itself
cap_done:
        xor     a
        ld      (sd_runf), a
        jr      stopped

; stopped: mirror the stop, report it, prompt.
stopped:
        call    sd_drain
        ld      a, (sd_rsn)
        ld      (MIRBLK+8), a
        ld      hl, (sd_sv+12)
        ld      (MIRBLK+4), hl
        ld      hl, (sd_sv+4)
        ld      (MIRBLK+6), hl
        ld      hl, msg_stop
        call    C_PRTMSG
        ld      a, (sd_rsn)
        call    C_CONOUT
        ld      a, (sd_rsn)
        cp      'B'
        jr      nz, st_nobp
        ld      a, ' '
        call    C_CONOUT
        ld      hl, (sd_sv+12)
        call    sd_hex16
st_nobp:
        call    C_CRLF
        call    print_regs
        xor     a
        ld      (sd_rsn), a
        jp      prompt

; ===============================================================
; L name: load a TOSD file to its directory load
; address (full records direct; the final partial
; record is staged through SECBUF, like the shell's
; R) and set a fresh context at its load address.
; ===============================================================
c_l:
        call    skip_sp
        ld      hl, (txtptr)
        ld      de, sd_name
        call    name_copy               ; util
        call    dir_load                ; util: DIRBUF
        ld      hl, sd_name
        ld      (find_name), hl         ; core var
        call    find_entry              ; util
        ld      a, E_FILE
        jp      c, err
        ; entry fields: +10 start record, +12 size,
        ; +14 load address (EDIS's walk)
        ld      de, 10
        add     hl, de
        ld      e, (hl)
        inc     hl
        ld      d, (hl)
        ld      (sd_ld_rec), de
        inc     hl
        ld      e, (hl)
        inc     hl
        ld      d, (hl)
        ld      (sd_ld_left), de
        ld      (sd_ld_size), de
        inc     hl
        ld      e, (hl)
        inc     hl
        ld      d, (hl)
        ld      (sd_ld_addr), de
        ld      (sd_ld_dest), de
cl_loop:
        ld      hl, (sd_ld_left)
        ld      a, h
        or      l
        jr      z, cl_done
        ld      de, 256
        or      a
        sbc     hl, de
        jr      nc, cl_full             ; >= 256 left
        ; final partial record: stage via SECBUF
        ld      de, (sd_ld_rec)
        ld      hl, SECBUF
        call    C_DREAD
        ld      a, E_FILE
        jp      c, err
        ld      hl, SECBUF
        ld      de, (sd_ld_dest)
        ld      bc, (sd_ld_left)
        ldir
        jr      cl_done
cl_full:
        ld      de, (sd_ld_rec)
        ld      hl, (sd_ld_dest)
        call    C_DREAD
        ld      a, E_FILE
        jp      c, err
        ld      hl, (sd_ld_dest)
        ld      de, 256
        add     hl, de
        ld      (sd_ld_dest), hl
        ld      hl, (sd_ld_rec)
        inc     hl
        ld      (sd_ld_rec), hl
        ld      hl, (sd_ld_left)
        ld      de, 256
        or      a
        sbc     hl, de
        ld      (sd_ld_left), hl
        jr      cl_loop
cl_done:
        ld      de, (sd_ld_addr)
        call    fresh_ctx               ; PC = load addr
        ld      hl, msg_load
        call    C_PRTMSG
        ld      hl, (sd_ld_addr)
        call    sd_hex16
        ld      a, ' '
        call    C_CONOUT
        ld      hl, (sd_ld_size)
        call    sd_hex16
        call    C_CRLF
        jp      cmd_done

; ===============================================================
; U [addr]: disassemble UWIND bytes of live memory
; with the shared decode core (memory mode reads the
; bytes in place; screen sink). Labels are generated
; for in-window targets exactly as in DISASM.
; ===============================================================
c_u:
        call    parse_opt
        jr      nc, cu_go
        ld      (sd_uptr), hl
cu_go:
        xor     a
        ld      (dr_cnt), a
        ld      (lab_cnt), a
        ld      (lab_cnt + 1), a
        ld      (out_mode), a           ; 0 = screen
        ld      a, 1
        ld      (src_mode), a           ; 1 = memory
        ld      hl, (sd_uptr)
        ld      (src_base), hl
        ld      hl, UWIND
        ld      (src_size), hl
        ld      hl, 0
        ld      (out_len), hl
        ld      (out_len + 2), hl
        ld      hl, 0ffffh
        ld      (cache_rec), hl
        call    pass1
        call    pass15
        call    pass2
        ld      hl, (sd_uptr)
        ld      de, UWIND
        add     hl, de
        ld      (sd_uptr), hl
        ld      (MIRBLK+10), hl         ; next U address
        ld      hl, (out_len)
        ld      (MIRBLK+12), hl         ; chars emitted
        jp      cmd_done

; ===============================================================
; Q: quit to the shell. Restores the breakpoint byte,
; the sub-CPU vector and the monitor's page-0 vectors,
; then RETs through the saved shell SP.
; ===============================================================
c_q:
        call    sd_unpatch
        call    sd_disarm
        ld      hl, sd_vec_save
        ld      de, 00030h
        ld      bc, 3
        ldir
        ld      hl, sd_vec_save+3
        ld      de, 00038h
        ld      bc, 3
        ldir
        ld      hl, sd_vec_save+6
        ld      de, 00066h
        ld      bc, 3
        ldir
        ld      hl, msg_bye
        call    C_PRTMSG
        xor     a
        ld      (sd_status), a
        ld      (MIRBLK+3), a
        ld      sp, (saved_sp)
        ei                              ; the shell runs
        ret                             ; interruptible

; ?: help.
c_help:
        ld      hl, msg_help
        call    C_PRTMSG
        jp      cmd_done

; ===============================================================
; err: A = error code (the shared core's error exit;
; DISASM/EDIS codes). Prints ERR n and re-enters the
; prompt (which resets SP, so any depth is safe). The
; code is sticky in the status mirror until the next
; successful command.
; ===============================================================
err:
        ld      (sd_status), a
        ld      (err_code), a           ; core var
        ld      hl, sd_errp
        call    C_PRTMSG
        ld      a, (sd_status)
        ld      l, a
        ld      h, 0
        call    print_dec               ; util
        call    C_CRLF
        jp      prompt

; ===============================================================
; Sub-CPU key vector control (the resident stub's
; proven procedures, re-implemented for the
; standalone: the monitor's kb_raw is not callable
; from here, so the raw transaction is done directly
; on the ports - it is a hardware protocol).
; ===============================================================
; sd_setvec: program the key-interrupt vector
; (command 0E4h + one data byte; 0 disarms). A staged
; transaction is drained first (sd_kbraw), because the
; core drops command bytes while one is staged.
sd_setvec:
        ld      (sd_vec), a
        call    sd_kbraw                ; drain (discarded)
        ld      bc, PPIB
        ld      e, 0
sv_w1:
        in      a, (c)
        and     040h
        jr      z, sv_s1
        dec     e
        jr      nz, sv_w1
sv_s1:
        ld      bc, SUBCPU
        ld      a, 0e4h
        out     (c), a
        ld      bc, PPIB
        ld      e, 0
sv_w2:
        in      a, (c)
        and     040h
        jr      z, sv_s2
        dec     e
        jr      nz, sv_w2
sv_s2:
        ld      bc, SUBCPU
        ld      a, (sd_vec)
        out     (c), a
        ret
sd_disarm:
        xor     a
        jr      sd_setvec

; sd_kbraw: one raw sub-CPU key transaction (the
; IPL's KBHIT, command 0E6h). -> A = ASCII code of
; the key currently down, or 0. Preserves BC.
sd_kbraw:
        push    bc
        ld      bc, PPIB
sk_w1:
        in      a, (c)
        and     040h
        jr      nz, sk_w1               ; wait while busy
        ld      bc, SUBCPU
        ld      a, 0e6h                 ; key input command
        out     (c), a
        ld      bc, PPIB
sk_w2:
        in      a, (c)
        and     040h
        jr      nz, sk_w2
        call    sk_read                 ; function byte (drop)
        call    sk_read                 ; ASCII byte -> A
        pop     bc
        ret
sk_read:
        ld      bc, PPIB
skr_w:
        in      a, (c)
        and     020h
        jr      nz, skr_w
        ld      bc, SUBCPU
        in      a, (c)
        ret

; sd_drain: discard keyboard input that arrived while
; a target ran (it belongs to the run, not to the
; next command) and re-sync the edge filter.
sd_drain:
        ld      a, (KBTAIL)
        ld      (KBHEAD), a             ; ring empty
        call    sd_kbraw
        ld      (KBPREV), a
        ret

; ===============================================================
; Print helpers.
; ===============================================================
sd_hex16:
        ld      a, h
        call    sd_hex8
        ld      a, l
        jp      sd_hex8
sd_hex8:
        push    af
        rrca
        rrca
        rrca
        rrca
        call    sd_hnib
        pop     af
sd_hnib:
        and     00fh
        cp     00ah
        jr      c, sh_n
        add     a, 007h
sh_n:
        add     a, 030h
        jp      C_CONOUT

; ===============================================================
; Strings
; ===============================================================
sd_banner:
        db      "RDBG - STANDALONE DEBUGGER", 13, 10, 0
msg_prompt:
        db      "RDBG> ", 0
msg_stop:
        db      13, 10, "STOP ", 0
msg_bp:
        db      "BP ", 0
msg_bpoff:
        db      "BP OFF", 13, 10, 0
sd_okp:
        db      "OK", 13, 10, 0
msg_go:
        db      "GO ", 0
msg_cont:
        db      "CONT ", 0
msg_load:
        db      "LOAD ", 0
msg_bye:
        db      "BYE", 13, 10, 0
sd_errp:
        db      "ERR ", 0
msg_quest:
        db      "?", 13, 10, 0
msg_help:
        db      "D [A] / M A B.. / R / B [A] / G [A] / C", 13, 10
        db      "L NAME / U [A] / Q / ?", 13, 10
        db      "ESC BREAKS A RUNNING TARGET. BP IS ONE-SHOT.", 13, 10, 0
r_pc:   db      "PC=", 0
r_sp:   db      "SP=", 0
r_af:   db      "AF=", 0
r_bc:   db      "BC=", 0
r_de:   db      "DE=", 0
r_hl:   db      "HL=", 0
r_ix:   db      "IX=", 0
r_iy:   db      "IY=", 0
r_saf:  db      "AF'=", 0
r_sbc:  db      "BC'=", 0
r_sde:  db      "DE'=", 0
r_shl:  db      "HL'=", 0
r_i:    db      "I=", 0

; ===============================================================
; Shared layers: the same sources DISASM and EDIS
; assemble (line input / parsing / TOSD directory in
; util; the decode core in core). Assemble from the
; rdbg/ directory.
; ===============================================================
        include "src/disasm_util.inc"
        include "src/disasm_core.inc"
after_core:

; ---- end of the read-only region (code + strings +
; the core's initialized data). Everything below is
; work area, excluded from the host's relocation
; comparison along with the core's own variable
; section (from saved_sp to after_core). ----
sd_ro_end:

; ===============================================================
; Work areas (in-body, so they travel with the image;
; contents are transient).
; ===============================================================
INBUF:          ds      48              ; GETLIN line
LINEBUF:        ds      128             ; core line assembly
sd_sv:          ds      26              ; captured registers
sd_spraw:       dw      0               ; target SP at capture
sd_key:         db      0               ; key from interrupt
sd_vec:         db      0               ; vector byte to send
sd_runf:        db      0               ; 1 while target runs
sd_rsn:         db      0               ; stop reason B/I/R
sd_status:      db      0               ; sticky status
sd_dptr:        dw      0               ; dump continuation
sd_uptr:        dw      0               ; U continuation
sd_bpa:         dw      0               ; breakpoint address
sd_bpb:         db      0               ; byte under the patch
sd_bps:         db      0               ; 1 while BP armed
sd_tmpw:        dw      0               ; M write pointer
sd_name:        ds      11              ; L name field
sd_ld_rec:      dw      0
sd_ld_size:     dw      0
sd_ld_addr:     dw      0
sd_ld_dest:     dw      0
sd_ld_left:     dw      0
sd_vec_save:    ds      9               ; saved page-0 vectors
sd_stack:       ds      256
sd_stack_top:
body_end:

        end
