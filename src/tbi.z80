; ---------------------------------------------------------------
; TBI - TinyBASIC interpreter (X1 / TapeOS, TOSD program).
;
; TBI shares its whole front end with TBC (tbcore.inc):
; lexer, parser, native code generator and the external
; function library. The difference is the execution model:
; instead of writing a TOSR file, TBI lays the program out
; in RAM at 08000h and runs it in place. Each function is
; compiled lazily on its first call (per-function JIT): the
; function's slot initially holds a JP to a small stub that
; asks jit_go to compile the function (measure + emit
; sub-passes over just that function) and then falls into
; the freshly compiled code with the caller's stack
; untouched. See ourobo-ros/tinybasic.md for the design.
;
; Load address 04000h like every TapeOS tool.
; ---------------------------------------------------------------

        org     04000h

        jp      driver_start

        include "tbcore.inc"

; ---------------------------------------------------------------
; Driver.
; ---------------------------------------------------------------
driver_start:
        ld      (saved_sp), sp
        ld      hl, STBLK
        ld      (hl), 'T'
        inc     hl
        ld      (hl), 'B'
        inc     hl
        ld      (hl), 'I'
        inc     hl
        ld      (hl), 0ffh              ; running
        ld      hl, drv_banner
        call    C_PRTMSG
        ld      hl, msg_srcp
        call    C_PRTMSG
        ld      hl, linebuf
        ld      b, 80
        call    C_GETLIN
        or      a
        ret     z                       ; empty: back to shell
        ld      hl, linebuf
        ld      de, name_src
        call    name_copy
        ; find the source file
        call    dir_load
        ld      hl, name_src
        ld      (find_name), hl
        call    find_entry
        ld      a, E_FILE
        jp      c, err                  ; source not found
        ld      de, 10
        add     hl, de
        ld      e, (hl)
        inc     hl
        ld      d, (hl)                 ; start record
        ld      (src_rec), de
        inc     hl
        ld      e, (hl)
        inc     hl
        ld      d, (hl)                 ; size
        ld      (src_size), de
        ; the module lives at ORIGIN in RAM; no stub, no
        ; relocation bitmap is needed
        ld      hl, ORIGIN
        ld      (outbase_v), hl
        ld      hl, 0
        ld      (rt_stub), hl
        ; ---- pass 1 + measure + layout (as in TBC) ----
        call    pass1
        ld      a, 1
        ld      (pass), a
        call    parse_program           ; measure
        call    layout
        ; rtentry expects (total_padded) = the module size
        ; rounded up to a page: the heap follows the module
        ld      hl, (bodysize)
        ld      de, 255
        add     hl, de
        xor     a
        ld      l, a
        ld      (total_padded), hl
        ; ---- skeleton: entry + JP stubs + library ----
        ld      a, 2
        ld      (pass), a
        ld      hl, 0
        ld      (epc), hl
        call    emit_rtentry
        xor     a
        ld      (jit_i), a
sk_lp:
        ld      a, (jit_i)
        ld      hl, fcount
        cp      (hl)
        jr      nc, sk_lib
        call    ftab_ptr                ; HL = entry
        ld      de, 16
        add     hl, de
        ld      e, (hl)
        inc     hl
        ld      d, (hl)                 ; DE = function address
        ld      hl, ORIGIN
        ex      de, hl
        or      a
        sbc     hl, de                  ; HL = body offset
        ld      (epc), hl
        ld      a, 0c3h                 ; JP stub_i
        call    e_b
        ld      a, (jit_i)
        ld      l, a
        ld      h, 0
        add     hl, hl
        add     hl, hl                  ; *4
        ld      a, (jit_i)
        ld      e, a
        ld      d, 0
        add     hl, de                  ; *5 (stub size; was
                                        ; *4, which misdispatched
                                        ; function index >= 3 --
                                        ; bug fix, roadmap id 63;
                                        ; same fix as sci.z80)
        ld      de, stubs
        add     hl, de
        call    e_w                     ; stub address (absolute)
        ld      a, (jit_i)
        inc     a
        ld      (jit_i), a
        jr      sk_lp
sk_lib:
        call    emit_library
        ; ---- status: OK, then run ----
        ld      hl, STBLK + 3
        ld      (hl), 0
        inc     hl
        ld      (hl), 0
        inc     hl
        ld      (hl), 0
        inc     hl
        ld      de, (bodysize)
        ld      (hl), e
        inc     hl
        ld      (hl), d
        ld      hl, msg_ok
        call    C_PRTMSG
        ld      hl, (bodysize)
        call    print_dec
        call    C_CRLF
        call    ORIGIN                  ; run the module
        ret

drv_banner: db  "TBI - TinyBASIC INTERPRETER", 13, 10, 0

; ---------------------------------------------------------------
; JIT stubs: one per function (FMAX = 16). Each loads its
; function index and jumps to jit_go. After the function is
; compiled, its slot no longer contains the JP that led
; here, so a stub runs at most once per function.
; ---------------------------------------------------------------
stubs:
        ld      a, 0
        jp      jit_go
        ld      a, 1
        jp      jit_go
        ld      a, 2
        jp      jit_go
        ld      a, 3
        jp      jit_go
        ld      a, 4
        jp      jit_go
        ld      a, 5
        jp      jit_go
        ld      a, 6
        jp      jit_go
        ld      a, 7
        jp      jit_go
        ld      a, 8
        jp      jit_go
        ld      a, 9
        jp      jit_go
        ld      a, 10
        jp      jit_go
        ld      a, 11
        jp      jit_go
        ld      a, 12
        jp      jit_go
        ld      a, 13
        jp      jit_go
        ld      a, 14
        jp      jit_go
        ld      a, 15
        jp      jit_go

; ---------------------------------------------------------------
; jit_go: A = function index. Entered by a JP from the
; stub, so the stack is exactly as the caller of the
; function left it: [retaddr][args...]. Pop the return
; address, compile the function, restore the stack and
; jump into the compiled code.
; ---------------------------------------------------------------
jit_go:
        ld      (jit_idx), a
        pop     hl                      ; caller return address
        ld      (jit_ret), hl
        call    jit_compile
        ld      hl, (jit_ret)
        push    hl
        ld      a, (jit_idx)
        call    ftab_ptr
        ld      de, 16
        add     hl, de
        ld      e, (hl)
        inc     hl
        ld      d, (hl)
        ex      de, hl
        jp      (hl)

; jit_compile: measure + emit sub-passes for (jit_idx).
jit_compile:
        ld      a, 1
        ld      (pass), a
        call    jit_preset
        call    parse_function
        ld      a, 2
        ld      (pass), a
        call    jit_preset
        call    parse_function
        ret

; jit_preset: rewind and skip to (jit_idx)'s FUNC token,
; then preset epc / litcur / label state so the sub-pass
; reproduces the load-time layout exactly.
jit_preset:
        call    jit_seek
        ld      a, (jit_idx)
        call    ftab_ptr                ; HL = entry
        push    hl
        ld      de, 16
        add     hl, de
        ld      e, (hl)
        inc     hl
        ld      d, (hl)                 ; DE = address
        ld      hl, ORIGIN
        ex      de, hl
        or      a
        sbc     hl, de                  ; HL = body offset
        ld      (epc), hl
        pop     hl
        ld      de, 30
        add     hl, de
        ld      e, (hl)
        inc     hl
        ld      d, (hl)                 ; DE = litstart
        ld      (litcur), de
        ld      hl, 0
        ld      (label_cnt), hl
        xor     a
        ld      (loopdep), a
        ld      (fordep), a
        ret

; jit_seek: rewind the source and advance to the FUNC
; token of function (jit_idx), skipping global
; declarations and earlier function bodies.
jit_seek:
        call    src_rewind
        call    lex
        xor     a
        ld      (jit_i), a
js_lp:
        ld      a, (tok)
        cp      K_DIM
        jr      z, js_glob
        cp      K_INT
        jr      z, js_glob
        cp      K_CHAR
        jr      z, js_glob
        ld      a, (jit_i)
        ld      hl, jit_idx
        cp      (hl)
        ret     z                       ; tok = K_FUNC of target
        ; skip this function body
js_sk:
        call    lex
        ld      a, (tok)
        cp      K_ENDFUNC
        jr      z, js_skdone
        or      a
        jp      z, pf_syn               ; EOF: cannot happen
        jr      js_sk
js_skdone:
        call    lex                     ; past ENDFUNC
        ld      a, (jit_i)
        inc     a
        ld      (jit_i), a
        jr      js_lp
js_glob:
        call    parse_global2
        jr      js_lp

; ---- TBI driver variables ----
jit_idx: db     0
jit_i: db       0
jit_ret: dw     0

        end
