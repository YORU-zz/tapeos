; tsload.z80 - Tiny Scheme 2-stage tape-head loader (tape file #1).
; ---------------------------------------------------------------
; P2 (OUROBO/ROS reproduction), roadmap id 32.
;
; A bare Tiny Scheme (sectorlisp-class core + boot primitives
; only) embedded in the tape-head loader that the X1 compatible
; IPL loads at classic speed.  Tape layout:
;   file #1  : this loader (TSLOAD)
;   block    : fixed-length script block (info name "SCRIPT",
;              4096-byte payload: 8-byte header + Scheme text)
;   file #2..: loadable programs (TapeOS shell, demos, ...)
;
; Boot flow: IPL loads file #1 -> the loader reads and
; validates the script block -> valid: the Scheme script runs
; (it is the stage-2 environment: selector / shell / editor,
; all written in Scheme itself) -> invalid or absent: a small
; native menu offers the same list/select/boot role.
;
; The script can be rewritten from inside the environment
; (script-save).  This core's CMT recorder cannot overwrite
; in place (REC appends, and a non-chained REC truncates), so
; script-save regenerates the whole tape with the identical
; layout; the fixed-length block keeps every later file at
; the same offset.  See ../tiny-scheme.md for the rationale.
;
; Memory map:
;   02000h..        this image (code + embedded final chunk)
;   06000h..07fffh  cons arena (2048 cells x 4 bytes)
;   08000h..08fffh  atom arena (512 objects x 8 bytes)
;   09000h..09fffh  string arena (symbol names, string bytes)
;   0a000h..0afffh  script payload buffer (4096 bytes)
;   0b000h..0dfffh  save staging area (12 KB)
;   0c800h          final-load chunk (copied in at load time)
;   0e600h..        stack (grows down); 0e680h = evidence block
;
; Value representation (16-bit):
;   odd                 fixnum, value = arithmetic (v >> 1)
;   0000h               nil (also false in `if`)
;   0002h / 0004h       #f / #t
;   even, bit1 = 0      cons pointer (cell: car, cdr)
;   even, bit1 = 1      object pointer-2; word at ptr-2 = type
;                       1 symbol [name-addr][name-len][0]
;                       2 string [bytes-addr][len][0]
;                       3 closure [params][body][env]
;                       4 primitive [index][0][0]
; No GC: arenas are bump-allocated and reset only at boot.
; ---------------------------------------------------------------

        org     02000h

SUBCPU          equ     01900h
PPIB            equ     01a01h
PPIC            equ     01a02h
SCRW            equ     40
SCRH            equ     25

CONS_BASE       equ     06000h
CONS_END        equ     08000h
ATOM_BASE       equ     08000h
ATOM_END        equ     09000h
STR_BASE        equ     09000h
STR_END         equ     0a000h
SCRBUF          equ     0a000h
SCRPSIZE        equ     4096
STAGE           equ     0b000h
STAGE_END       equ     0e000h
FINADDR         equ     0c800h
EVID            equ     0e680h
STKTOP          equ     0e600h

T_SYM           equ     1
T_STR           equ     2
T_CLO           equ     3
T_PRIM          equ     4

; error codes
E_UNBOUND       equ     1
E_TYPE          equ     2
E_ARITY         equ     3
E_READ          equ     4
E_HEAP          equ     5
E_TAPE          equ     6
E_NOTPROC       equ     7
E_BIG           equ     8
E_DIV0          equ     9
E_FORM          equ     10

; ===============================================================
; entry
; ===============================================================
        include "finlen.inc"

start:
        di
        ld      sp, STKTOP
        ld      (save_sp), sp
        call    clrscr
        ld      hl, msg_title
        call    con_puts
        ; the IPL stopped the deck right after file #1's data;
        ; the script block's info block follows immediately.
        call    read_script_block       ; carry = no valid block
        jp      c, menu
        ; validate payload header
        call    validate_script         ; carry = invalid
        jp      c, menu
        call    scheme_init
        ; run the script text as Scheme source
        ld      hl, SCRBUF + 8
        ld      a, (scr_len)
        ld      e, a
        ld      a, (scr_len + 1)
        ld      d, a                    ; de = length
        call    run_source              ; hl=ptr de=len
        ; script returned (or fell through): drop to the menu
        jp      menu

; fatal Scheme error landing pad: SP was reset by err_throw.
err_land:
        ld      hl, msg_err
        call    con_puts
        ld      a, (err_code)
        call    con_putdec
        call    con_crlf
        jp      menu

; ===============================================================
; native fallback menu (also the (exit-menu) primitive target)
; ===============================================================
menu:
        ld      sp, STKTOP
        ld      (save_sp), sp
        ; evidence: native menu ran
        ld      hl, sig_menu
        ld      de, EVID
        ld      bc, 4
        ldir
        call    clrscr
        ld      hl, msg_menu
        call    con_puts
        call    scan_files              ; fills ftab, (nfiles)
        ld      a, (nfiles)
        or      a
        jp      z, menu_nofiles
        ld      b, a
        ld      hl, ftab
        ld      c, 1                    ; 1-based index display
menu_list:
        push    bc
        push    hl
        ld      a, c
        call    con_putdec
        ld      a, ':'
        call    con_putc
        ld      a, ' '
        call    con_putc
        pop     hl
        push    hl
        call    con_puts                ; name (NUL-terminated)
        ld      a, ' '
        call    con_putc
        pop     hl
        push    hl
        ld      de, 18
        add     hl, de                  ; size word
        ld      e, (hl)
        inc     hl
        ld      d, (hl)
        ex      de, hl
        call    con_putdec16
        pop     hl
        ld      de, 26
        add     hl, de
        pop     bc
        inc     c
        call    con_crlf
        djnz    menu_list
        ld      hl, msg_sel
        call    con_puts
menu_key:
        call    kb_getkey
        cp      'q'
        jr      z, menu_halt
        cp      'Q'
        jr      z, menu_halt
        cp      's'
        jr      z, menu_rescript
        cp      'S'
        jr      z, menu_rescript
        cp      '1'
        jr      c, menu_key
        cp      '9' + 1
        jr      nc, menu_key
        sub     '1'
        ld      hl, nfiles
        cp      (hl)
        jr      nc, menu_key
        ; a = 0-based index: load and jump (never returns ok)
        call    load_file_n
        ; load error: report and re-menu
        ld      hl, msg_loaderr
        call    con_puts
        jp      menu
menu_rescript:
        ; re-read the script block from the tape head
        ld      a, 4
        call    tp_ctrl                 ; REW
        call    skip_first_file
        jp      c, menu
        call    read_script_block
        jp      c, menu
        call    validate_script
        jp      c, menu
        call    scheme_init
        ld      hl, SCRBUF + 8
        ld      a, (scr_len)
        ld      e, a
        ld      a, (scr_len + 1)
        ld      d, a
        call    run_source
        jp      menu
menu_nofiles:
        ld      hl, msg_nofiles
        call    con_puts
menu_halt:
        halt
        jr      menu_halt

; ===============================================================
; console (text VRAM via ports; 40 x 25, offset = y*40 + x)
; ===============================================================
        include "vram_x1.inc"

; clrscr: fill text screen with spaces, cursor home.
clrscr:
        xor     a
        ld      (cur_x), a
        ld      (cur_y), a
        ld      a, 07h
        ld      (cur_attr), a
        ld      hl, 0
        ld      bc, SCRW * SCRH
clr_l:
        push    bc
        push    hl
        ld      a, ' '
        call    wr_cell
        pop     hl
        inc     hl
        pop     bc
        dec     bc
        ld      a, b
        or      c
        jr      nz, clr_l
        ret

; cur_offset: hl = cur_y * 40 + cur_x (preserves de, bc)
cur_offset:
        ld      a, (cur_y)
        ld      hl, 0
        or      a
        jr      z, cof_x
        ld      de, SCRW
cof_m:
        add     hl, de
        dec     a
        jr      nz, cof_m
cof_x:
        ld      a, (cur_x)
        ld      e, a
        ld      d, 0
        add     hl, de
        ret

; con_putc: print a (CR, LF, BS and printable handled).
; preserves bc, de, hl.
con_putc:
        cp      13
        jr      z, cpc_lf
        cp      10
        jr      z, cpc_lf
        cp      8
        jr      z, cpc_bs
        cp      ' '
        ret     c
        push    hl
        push    af
        call    cur_offset
        pop     af
        call    wr_cell
        pop     hl
        ld      a, (cur_x)
        inc     a
        cp      SCRW
        jr      nc, cpc_lf
        ld      (cur_x), a
        ret
cpc_lf:
        xor     a
        ld      (cur_x), a
        ld      a, (cur_y)
        inc     a
        cp      SCRH
        jr      nc, cpc_scroll
        ld      (cur_y), a
        ret
cpc_scroll:
        push    bc
        push    de
        push    hl
        call    scroll_up
        pop     hl
        pop     de
        pop     bc
        ld      a, SCRH - 1
        ld      (cur_y), a
        ret
cpc_bs:
        ld      a, (cur_x)
        or      a
        ret     z
        dec     a
        ld      (cur_x), a
        ret

; scroll_up: move rows 1..24 to 0..23, clear row 24.
scroll_up:
        push    bc
        push    de
        push    hl
        ld      hl, SCRW
        ld      bc, SCRW * (SCRH - 1)
scu_l:
        push    bc
        push    hl
        call    rd_chr
        ex      (sp), hl
        push    af
        ld      de, -SCRW
        add     hl, de
        pop     af
        call    wr_cell
        pop     hl
        inc     hl
        pop     bc
        dec     bc
        ld      a, b
        or      c
        jr      nz, scu_l
        ld      hl, SCRW * (SCRH - 1)
        ld      bc, SCRW
scu_c:
        push    bc
        push    hl
        ld      a, ' '
        call    wr_cell
        pop     hl
        inc     hl
        pop     bc
        dec     bc
        ld      a, b
        or      c
        jr      nz, scu_c
        pop     hl
        pop     de
        pop     bc
        ret

; con_puts: print NUL-terminated string at hl.
con_puts:
        ld      a, (hl)
        or      a
        ret     z
        inc     hl
        push    hl
        call    con_putc
        pop     hl
        jr      con_puts

; con_crlf
con_crlf:
        ld      a, 10
        jp      con_putc

; con_putdec: print a as unsigned decimal (0..255)
con_putdec:
        ld      l, a
        ld      h, 0
        jr      con_putdec16
; con_putdec16: print hl as unsigned decimal
con_putdec16:
        push    bc
        xor     a
        ld      (cpd_started), a
        push    de
        push    hl
        ld      de, 10000
        call    cpd_dig
        ld      de, 1000
        call    cpd_dig
        ld      de, 100
        call    cpd_dig
        ld      de, 10
        call    cpd_dig
        ld      a, l
        add     a, '0'
        call    con_putc
        pop     hl
        pop     de
        pop     bc
        ret
cpd_dig:
        ; hl /= de digit print (suppresses leading zeros via
        ; the 'started' flag in (cpd_started))
        push    bc
        ld      b, 0
cpd_l:
        or      a
        sbc     hl, de
        jr      c, cpd_done
        inc     b
        jr      cpd_l
cpd_done:
        add     hl, de
        ld      a, b
        or      a
        jr      nz, cpd_print
        ld      a, (cpd_started)
        or      a
        jr      z, cpd_ret
cpd_print:
        ld      a, 1
        ld      (cpd_started), a
        ld      a, b
        add     a, '0'
        call    con_putc
cpd_ret:
        pop     bc
        ret

; ===============================================================
; keyboard
; ===============================================================
        include "kb_x1.inc"

; kb_getkey: block until a key is pressed; return its ASCII
; code in a.  Waits for release before returning so one press
; is seen once.  Preserves bc, de, hl.
kb_getkey:
        push    bc
        push    hl
kgk_w1:
        call    rnd_tick_inc
        call    kb_raw
        or      a
        jr      z, kgk_w1
        ld      h, a
kgk_w2:
        call    rnd_tick_inc
        call    kb_raw
        or      a
        jr      nz, kgk_w2
        ld      a, h
        pop     hl
        pop     bc
        ret

; getline: read one line into linebuf (max 127 chars), echo.
; Returns length in a; linebuf is NUL-terminated.
getline:
        push    bc
        push    de
        push    hl
        ld      hl, linebuf
        ld      b, 0                    ; length
gl_l:
        call    kb_getkey
        cp      13
        jr      z, gl_done
        cp      10
        jr      z, gl_done
        cp      8
        jr      z, gl_bs
        cp      ' '
        jr      c, gl_l
        cp      07fh
        jr      nc, gl_l
        ld      c, a
        ld      a, b
        cp      127
        jr      nc, gl_l
        ld      a, c
        ld      (hl), a
        inc     hl
        inc     b
        push    bc                      ; con_putc destroys bc
        call    con_putc
        pop     bc
        jr      gl_l
gl_bs:
        ld      a, b
        or      a
        jr      z, gl_l
        dec     b
        dec     hl
        push    bc
        ld      a, 8
        call    con_putc
        ld      a, ' '
        call    con_putc
        ld      a, 8
        call    con_putc
        pop     bc
        jr      gl_l
gl_done:
        ld      (hl), 0
        call    con_crlf
        ld      a, b
        pop     hl
        pop     de
        pop     bc
        ret

; ===============================================================
; tape (classic speed; routines from TapeOS tape_x1.inc)
; ===============================================================
        include "tape_x1.inc"

; ---- shared info-block helpers ----
; infobuf layout (34 bytes read by i_tinf):
;   +0 flag, +1..13 name, +14..16 ext, +17 password,
;   +18 size LE16, +20 load LE16, +22 exec LE16, +24 date 6,
;   +30 offset 3, +32 checksum 2 (read but unused here)

; info_size: hl = size field of infobuf
info_size:
        ld      hl, (infobuf + 18)
        ret

; skip_info_data: skip the data block belonging to infobuf.
; carry = error.  preserves the infobuf contents.
skip_info_data:
        call    info_size
        ex      de, hl
        jp      tp_skipdat

; name_is_script: zero flag set if infobuf name is "SCRIPT".
name_is_script:
        push    hl
        push    de
        push    bc
        ld      hl, infobuf + 1
        ld      de, str_script
        ld      b, 6
nis_l:
        ld      a, (de)
        cp      (hl)
        jr      nz, nis_no
        inc     hl
        inc     de
        djnz    nis_l
        ld      a, (hl)                 ; 7th name char: space
        cp      ' '
        jr      nz, nis_no
        xor     a                       ; set zero
        jr      nis_x
nis_no:
        or      1                       ; clear zero
nis_x:
        pop     bc
        pop     de
        pop     hl
        ret

; read_info: read one info block into infobuf.  carry = error.
read_info:
        ld      hl, infobuf
        jp      i_tinf

; skip_first_file: (re)position after file #1: reads its info
; and skips its data.  carry = error.
skip_first_file:
        call    read_info
        ret     c
        jp      skip_info_data

; prologue_files: after skip_first_file, read the next info;
; if it is the script block, skip it and read the following
; info.  On success infobuf holds the first loadable file's
; info and the tape sits right after that info block.
; carry = error (no files).
prologue_files:
        call    read_info
        ret     c
        call    name_is_script
        ret     nz                      ; not script: done
        call    skip_info_data
        ret     c
        jp      read_info

; ---- script block ----
; read_script_block: the tape must be positioned right after
; file #1's data.  Reads the block into SCRBUF if the next
; info block is the script block.  carry = absent / error.
read_script_block:
        call    read_info
        ret     c
        call    name_is_script
        jr      z, rsb_go
        scf
        ret
rsb_go:
        ld      hl, SCRBUF
        ld      de, SCRPSIZE
        jp      i_tdat

; validate_script: check the payload header at SCRBUF:
; magic "TS", version 1, length <= SCRPSIZE-8, checksum =
; 16-bit byte sum of the text.  Sets (scr_len).  carry = bad.
validate_script:
        ld      hl, SCRBUF
        ld      a, (hl)
        cp      'T'
        jr      nz, vs_bad
        inc     hl
        ld      a, (hl)
        cp      'S'
        jr      nz, vs_bad
        inc     hl
        ld      a, (hl)
        cp      1
        jr      nz, vs_bad
        ld      hl, (SCRBUF + 4)        ; length
        ld      de, SCRPSIZE - 8
        or      a
        sbc     hl, de
        jr      c, vs_lenok
        jr      z, vs_lenok
        jr      vs_bad
vs_lenok:
        ld      hl, (SCRBUF + 4)
        ld      (scr_len), hl
        ; checksum over text bytes
        ld      de, 0                   ; sum
        ld      bc, SCRBUF + 8
        ld      a, h
        or      l
        jr      z, vs_cmp
vs_sum:
        ld      a, (bc)
        inc     bc
        add     a, e
        ld      e, a
        jr      nc, vs_nc
        inc     d
vs_nc:
        dec     hl
        ld      a, h
        or      l
        jr      nz, vs_sum
vs_cmp:
        ld      hl, (SCRBUF + 6)
        or      a
        sbc     hl, de
        jr      nz, vs_bad
        or      a                       ; carry = 0
        ret
vs_bad:
        scf
        ret

; ---- file scan ----
; scan_files: REW, walk the whole tape, fill ftab with the
; loadable files (loader and script block excluded).
; Entry = 26 bytes: name NUL-terminated at +0 (<=17 chars +
; NUL = 18 bytes), size +18, load +20, exec +22, flag +24.
; Sets (nfiles).  Tape errors simply end the scan.
scan_files:
        xor     a
        ld      (nfiles), a
        ld      a, 4
        call    tp_ctrl                 ; REW
        call    skip_first_file
        ret     c
        call    prologue_files
        ret     c
        ld      hl, ftab
        ld      (ftab_ptr), hl
sf_loop:
        ; record infobuf into (ftab_ptr)
        ld      hl, (ftab_ptr)
        push    hl
        ex      de, hl                  ; de = entry
        ld      hl, infobuf + 1
        ld      b, 13                   ; name
        call    sf_copytrim
        ld      a, (infobuf + 14)
        cp      ' '
        jr      z, sf_noext
        ld      a, '.'
        ld      (de), a
        inc     de
        ld      hl, infobuf + 14
        ld      b, 3                    ; ext
        call    sf_copytrim
sf_noext:
        xor     a
        ld      (de), a                 ; NUL terminate
        pop     hl
        push    hl
        ld      de, 18
        add     hl, de
        ex      de, hl
        ld      hl, infobuf + 18
        ld      bc, 6                   ; size, load, exec
        ldir
        ld      a, (infobuf)
        ld      (de), a                 ; flag at +24 (de now
        pop     hl                      ;   at +24 after 6 bytes
        ld      de, 26                  ;   from +18)
        add     hl, de
        ld      (ftab_ptr), hl
        ld      a, (nfiles)
        inc     a
        ld      (nfiles), a
        cp      12
        ret     nc                      ; table full
        call    skip_info_data
        ret     c
        call    read_info
        ret     c
        jr      sf_loop
; sf_copytrim: copy b bytes hl->de, dropping trailing spaces.
; de ends just past the last non-space byte copied.
sf_copytrim:
        push    de                      ; start of copy
        ld      c, 0                    ; trailing-space count
sft_cp:
        ld      a, (hl)
        inc     hl
        ld      (de), a
        inc     de
        cp      ' '
        jr      z, sft_spc
        ld      c, 0
        jr      sft_nx
sft_spc:
        inc     c
sft_nx:
        djnz    sft_cp
        ld      a, e
        sub     c
        ld      e, a
        jr      nc, sft_ok
        dec     d
sft_ok:
        pop     af                      ; discard start
        ret

; ---- load file n and jump ----
; load_file_n: a = 0-based index among loadable files.
; Never returns on success (the final chunk jumps to the
; loaded program).  Returns with carry on tape error.
load_file_n:
        ld      (want_idx), a
        ld      a, 4
        call    tp_ctrl                 ; REW
        call    skip_first_file
        ret     c
        call    prologue_files
        ret     c
        ld      a, (want_idx)
        or      a
        jr      z, lfn_go
lfn_skip:
        push    af
        call    skip_info_data
        pop     af
        ret     c
        push    af
        call    read_info
        pop     af
        ret     c
        dec     a
        jr      nz, lfn_skip
lfn_go:
        ; copy the final-load chunk to FINADDR and poke params
        ld      hl, fin_blob
        ld      de, FINADDR
        ld      bc, FIN_LEN
        ldir
        ld      hl, (infobuf + 20)      ; load addr
        ld      (FINADDR + 3), hl
        ld      hl, (infobuf + 18)      ; size
        ld      (FINADDR + 5), hl
        ld      hl, (infobuf + 22)      ; exec addr
        ld      (FINADDR + 7), hl
        jp      FINADDR

; ---- script save (whole-tape regeneration) ----
; save_script_native: (scr_new_ptr)/(scr_new_len) point at the
; new script text (Scheme string bytes).  Builds the payload
; at SCRBUF, stages every loadable file into STAGE.., then
; records loader + script + files as one chained REC session
; (the first REC truncates the old tape in the core, which is
; exactly the regeneration semantics we want).
; carry = error (E_BIG if staging overflows).
save_script_native:
        ; build payload header at SCRBUF
        ld      hl, SCRBUF
        ld      (hl), 'T'
        inc     hl
        ld      (hl), 'S'
        inc     hl
        ld      (hl), 1
        inc     hl
        ld      (hl), 0
        inc     hl
        ld      a, (scr_new_len)
        ld      (hl), a
        inc     hl
        ld      a, (scr_new_len + 1)
        ld      (hl), a
        ; copy text + checksum
        ld      hl, (scr_new_ptr)
        ld      de, SCRBUF + 8
        ld      bc, (scr_new_len)
        ld      a, b
        or      c
        jr      z, ssn_pad
        ldir
ssn_pad:
        ; zero the rest of the payload
        ld      hl, SCRBUF + 8
        ld      bc, (scr_new_len)
        add     hl, bc
        ld      a, (scr_new_len)
        ld      e, a
        ld      a, (scr_new_len + 1)
        ld      d, a                    ; de = text length
        push    hl
        ld      hl, SCRPSIZE - 8
        or      a
        sbc     hl, de                  ; remaining = total-len
        ld      b, h
        ld      c, l
        pop     hl
        jr      z, ssn_ck
        jr      c, ssn_ck
ssn_zl:
        ld      (hl), 0
        inc     hl
        dec     bc
        ld      a, b
        or      c
        jr      nz, ssn_zl
ssn_ck:
        ld      de, 0
        ld      hl, SCRBUF + 8
        ld      bc, (scr_new_len)
        ld      a, b
        or      c
        jr      z, ssn_ckd
ssn_ckl:
        ld      a, (hl)
        inc     hl
        add     a, e
        ld      e, a
        jr      nc, ssn_nc
        inc     d
ssn_nc:
        dec     bc
        ld      a, b
        or      c
        jr      nz, ssn_ckl
ssn_ckd:
        ld      (SCRBUF + 6), de
        ld      a, (scr_new_len)
        ld      (scr_len), a
        ld      a, (scr_new_len + 1)
        ld      (scr_len + 1), a
        ; ---- stage all loadable files ----
        ld      hl, STAGE
        ld      (stage_ptr), hl
        ld      a, 4
        call    tp_ctrl                 ; REW
        call    skip_first_file
        ret     c
        call    prologue_files
        ret     c
ssn_stage:
        ld      de, (stage_ptr)         ; write cursor
        ld      hl, STAGE_END - 34
        or      a
        sbc     hl, de
        jr      c, ssn_big              ; no room for the info
        ld      hl, infobuf
        ld      bc, 34
        ldir                            ; de = data dest
        ld      hl, (infobuf + 18)      ; size
        add     hl, de                  ; end = dest + size
        ld      bc, STAGE_END
        or      a
        sbc     hl, bc
        jr      nc, ssn_big             ; would reach the end
        ld      hl, (infobuf + 18)
        ex      de, hl                  ; hl=dest, de=size
        call    i_tdat
        ret     c
        add     hl, de                  ; i_tdat preserves both
        ld      (stage_ptr), hl
        call    read_info
        jr      c, ssn_done             ; end of tape: all staged
        jr      ssn_stage
ssn_done:
        or      a                       ; success: carry clear
        ret
ssn_big:
        ld      a, E_BIG
        ld      (save_err), a
        scf
        ret

; record_tape: record loader + script payload + staged files.
; Called after save_script_native staged everything and built
; the payload.  carry = error (should not happen).
record_tape:
        ld      hl, img_end
        ld      de, 02000h
        or      a
        sbc     hl, de
        ld      (loader_size), hl
        ; file #1: the loader itself (image in RAM at 2000h)
        ld      hl, infobuf
        ld      (hl), 1                 ; boot flag
        inc     hl
        ld      de, str_tsload
        ld      bc, 13
        ex      de, hl
        ldir
        ex      de, hl
        ld      (hl), 'S'
        inc     hl
        ld      (hl), 'y'
        inc     hl
        ld      (hl), 's'
        inc     hl
        ld      (hl), 0                 ; password
        inc     hl
        ld      de, (loader_size)
        ld      (hl), e
        inc     hl
        ld      (hl), d
        inc     hl
        ld      (hl), 000h              ; load 2000h
        inc     hl
        ld      (hl), 020h
        inc     hl
        ld      (hl), 000h              ; exec 2000h
        inc     hl
        ld      (hl), 020h
        ld      hl, infobuf
        call    i_twinf
        ld      hl, 02000h
        ld      de, (loader_size)
        call    i_twdat
        ; script block
        ld      hl, infobuf
        ld      (hl), 0
        inc     hl
        ld      de, str_script16
        ld      bc, 13
        ex      de, hl
        ldir
        ex      de, hl
        ld      (hl), 'T'
        inc     hl
        ld      (hl), 'S'
        inc     hl
        ld      (hl), ' '
        inc     hl
        ld      (hl), 0
        inc     hl
        ld      de, SCRPSIZE
        ld      (hl), e
        inc     hl
        ld      (hl), d
        inc     hl
        xor     a
        ld      (hl), a                 ; load 0
        inc     hl
        ld      (hl), a
        inc     hl
        ld      (hl), a                 ; exec 0
        inc     hl
        ld      (hl), a
        ld      hl, infobuf
        call    i_twinf
        ld      hl, SCRBUF
        ld      de, SCRPSIZE
        call    i_twdat
        ; staged files
        ld      hl, STAGE
rt_loop:
        ld      a, (stage_ptr)
        cp      l
        jr      nz, rt_more
        ld      a, (stage_ptr + 1)
        cp      h
        ret     z                       ; all recorded
rt_more:
        push    hl
        call    i_twinf                 ; hl = staged info (32B)
        pop     hl
        push    hl
        ld      de, 18
        add     hl, de
        ld      e, (hl)
        inc     hl
        ld      d, (hl)                 ; size
        pop     hl
        push    hl
        push    de
        ld      de, 34
        add     hl, de                  ; data start
        pop     de
        call    i_twdat
        pop     hl
        ld      de, 18
        add     hl, de
        ld      e, (hl)
        inc     hl
        ld      d, (hl)
        inc     hl                      ; hl = info+20; want +34
        ld      bc, 14
        add     hl, bc
        add     hl, de
        jr      rt_loop

        include "tscore.inc"
; ===============================================================
; final-load chunk (assembled separately at FINADDR, copied
; there by load_file_n before the actual data read)
; ===============================================================
fin_blob:
        include "fin.inc"
img_end:
