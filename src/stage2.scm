(define *msg* "STAGE-1")
; Stage 2: self-extension in Scheme. Block surgery is
; native (block-splice!): per-byte Scheme loops would
; exhaust the no-GC arenas on a 4 KB block.
(define (poke-msg i n)
  (if (< i n)
      (begin (poke (+ 59012 i) (string-ref *msg* i))
             (poke-msg (+ i 1) n))
      #t))
(define (banner)
  (display "TINY SCHEME 2-STAGE BOOT") (newline)
  (display "MSG: ") (display *msg*) (newline)
  (poke 59008 84) (poke 59009 83)
  (poke 59010 83) (poke 59011 49)
  (poke-msg 0 (if (< (string-length *msg*) 4)
                  (string-length *msg*) 4)))
(define (show-files fs i)
  (if (null? fs) #t
      (begin (display i) (display ": ")
             (display (car (car fs))) (display " ")
             (display (car (cdr (car fs)))) (newline)
             (show-files (cdr fs) (+ i 1)))))
(define (ls) (show-files (tape-scan) 1))
(define (word-end s i)
  (if (= i (string-length s)) i
      (if (= (string-ref s i) 32) i
          (word-end s (+ i 1)))))
(define (tget i) (block-ref (+ i 8)))
(define (tput i b) (block-set! (+ i 8) b))
(define (splice! a b s) (block-splice! a b s))
(define (findq i) (block-find i 34))
(define (set-msg! new)
  (splice! 15 (findq 15) new)
  (set! *msg* new)
  (display "MSG SET") (newline))
(define (line-start n) (block-line-start n))
(define (line-end i)
  (define j (block-find i 10))
  (if (= j -1) (script-len) j))
(define (print-lines) (plw 1 0))
(define (plw ln a)
  (if (>= a (script-len)) #t
      (begin (define e (line-end a))
             (display ln) (display ": ")
             (display (substring (script-text) a e))
             (newline)
             (plw (+ ln 1) (+ e 1)))))
(define (ed-loop)
  (display "ED> ")
  (define line (read-line))
  (cond ((string=? line "q")
         (begin (display "ED QUIT") (newline)))
        ((string=? line "p")
         (begin (print-lines) (ed-loop)))
        (else
          (define n (string->number line))
          (if n
              (begin (display "TEXT: ")
                     (define a (line-start n))
                     (if (= a -1)
                         (display "NO LINE")
                         (splice! a (line-end a) (read-line)))
                     (newline)
                     (ed-loop))
              (begin (display "?") (newline)
                     (ed-loop))))))
(define (editor)
  (display "ED: p=print N=replace q=quit")
  (newline)
  (ed-loop))
(define (do-cmd line)
  (define e (word-end line 0))
  (define w (substring line 0 e))
  (define arg (if (= e (string-length line)) ""
                  (substring line (+ e 1) (string-length line))))
  (cond ((string=? w "ls") (ls))
        ((string=? w "run")
         (define n (string->number arg))
         (if n (boot n)
             (begin (display "BAD NUM") (newline))))
        ((string=? w "msg") (set-msg! arg))
        ((string=? w "save")
         (begin (script-save-current)
                (display "SAVED") (newline)))
        ((string=? w "ed") (editor))
        ((string=? w "menu") (exit-menu))
        ((string=? w "") #t)
        (else (begin (display "?CMD") (newline)))))
(define (shell)
  (display "TS> ")
  (define line (read-line))
  (if (string=? line "quit")
      (exit-menu)
      (begin (do-cmd line) (shell))))
(banner)
(shell)
