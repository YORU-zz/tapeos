; ---------------------------------------------------------------
; Messages
; ---------------------------------------------------------------
msg_banner:
        db      "TAPEOS EDAS - EDITOR/ASSEMBLER", 13, 10
        IF      DEFINED EDAS_MZ
        db      "ALL I/O VIA IOCS 0C400H - H = HELP", 13, 10, 0
        ELSE
        db      "ALL I/O VIA IOCS 0E400H - H = HELP", 13, 10, 0
        ENDIF
msg_prompt:
        db      13, 10, "ED> ", 0
msg_err:
        db      "?", 0
msg_new:
        db      "TEXT CLEARED", 13, 10, 0
msg_empty:
        db      "EMPTY", 13, 10, 0
msg_full:
        db      "TEXT BUFFER FULL", 13, 10, 0
msg_dot:
        db      "(TYPE LINES, . = END)", 13, 10, 0
msg_lines:
        db      " LINES", 13, 10, 0
msg_saved:
        db      " SAVED", 13, 10, 0
msg_nofile:
        db      "NO FILES", 13, 10, 0
msg_drv0:
        db      "DRIVE 0: FD", 13, 10, 0
msg_drv1:
        db      "DRIVE 1: RAMDISK", 13, 10, 0
msg_rdtag:
        db      "RAMDISK:", 13, 10, 0
msg_asmok:
        db      "ASM OK ", 0
msg_bytes:
        db      " BYTES", 13, 10, 0
msg_errpre:
        db      "ERR LINE ", 0
msg_help:
        db      "H: HELP        N: NEW TEXT", 13, 10
        db      "P [A [B]]: PRINT LINES", 13, 10
        db      "A: APPEND LINES (. = END)", 13, 10
        db      "I N: INSERT BEFORE LINE N", 13, 10
        db      "D N [M]: DELETE LINES N..M", 13, 10
        db      "E N: EDIT LINE N", 13, 10
        db      "R NAME: READ TEXT FILE", 13, 10
        db      "W NAME: WRITE TEXT FILE", 13, 10
        db      "F: LIST FILES", 13, 10
        db      "U [D]: DRIVE (0=FD 1=RAMDISK)", 13, 10
        db      "B [NAME]: ASSEMBLE [AND SAVE]", 13, 10
        IF      !DEFINED EDAS_TOSR
        db      "Z: DISASSEMBLE TO TEXT (EDIS)", 13, 10
        ENDIF
        IF      DEFINED EDAS_TOSR
        db      "  (RELOC FIRST LINE = TOSR OUTPUT)", 13, 10
        ENDIF
        db      "Q: QUIT TO SHELL", 0

