; scc.z80 - SCC: the Small-C compiler for TapeOS (X1).
; OUROBO/ROS reproduction project (P2), roadmap item 7.
;
; SCC compiles the Small-C subset (see smallc-tos.md) to
; TOSR relocatable binaries. The front end (file layer,
; preprocessor, lexer, parser, code generator, library
; linker, layout) is shared with the JIT interpreter SCI:
; see sccore.inc. This driver adds the compile-to-file
; flow: prompts, the TOSR composition (stage-1 stub +
; body + relocation bitmap + trailer) and the file save.
; The driver is adapted from TinyBASIC's TBC.
;
; Memory map:
;   04000h..        this program (code + data)
;   (memory map in sccore.inc: binary to 071ffh,
;   DIRBUF 07200h, source buffers 07300h.., symbol
;   tables 07600h.., bitmap 0c800h, macro areas 0d200h+)
;   08000h..        output file image (stub at 08000h,
;                   body at 0806dh), guarded to 0c000h+

        include "sccore.inc"

; ---------------------------------------------------------------
; Driver entry.
; ---------------------------------------------------------------
driver_start:
        ld      (saved_sp), sp
        ld      hl, STBLK
        ld      (hl), 'S'
        inc     hl
        ld      (hl), 'C'
        inc     hl
        ld      (hl), 'C'
        inc     hl
        ld      (hl), 0ffh              ; running
        ld      hl, drv_banner
        call    C_PRTMSG
        ld      hl, msg_srcp
        call    C_PRTMSG
        ld      hl, linebuf
        ld      b, 80
        call    C_GETLIN
        or      a
        ret     z                       ; empty: back to shell
        ld      hl, linebuf
        ld      de, name_src
        call    name_copy
        ld      hl, msg_outp
        call    C_PRTMSG
        ld      hl, linebuf
        ld      b, 80
        call    C_GETLIN
        or      a
        ret     z
        ld      hl, linebuf
        ld      de, name_out
        call    name_copy
        ; find the source file
        call    dir_load
        ld      hl, name_src
        ld      (find_name), hl
        call    find_entry
        ld      a, E_FILE
        jp      c, err                  ; source not found
        ld      de, 10
        add     hl, de
        ld      e, (hl)
        inc     hl
        ld      d, (hl)                 ; start record
        ld      (main_rec), de
        inc     hl
        ld      e, (hl)
        inc     hl
        ld      d, (hl)                 ; size
        ld      (main_size), de
        ; compile into a TOSR file: body at 0806dh,
        ; preceded by the 109-byte stage-1 stub
        ld      hl, ORIGIN
        ld      (outbase_v), hl
        ld      hl, STUB_LEN
        ld      (rt_stub), hl
        ld      hl, 06000h
        ld      (heap_limit), hl
        ; ---- the three passes ----
        call    pass1
        ld      a, 1
        ld      (pass), a
        call    parse_program           ; measure
        call    layout
        ld      a, 2
        ld      (pass), a
        call    emit_setup
        call    parse_program           ; emit
        call    emit_library
        call    emit_finish
        ; ---- save the TOSR image ----
        ld      hl, ORIGIN
        ld      (sv_addr), hl
        ld      hl, (total_file)
        ld      (sv_len), hl
        ld      hl, ORIGIN
        ld      (sv_load), hl
        call    save_file
        ; ---- status: OK ----
        ld      hl, STBLK + 3
        ld      (hl), 0
        inc     hl
        ld      (hl), 0
        inc     hl
        ld      (hl), 0
        inc     hl
        ld      de, (total_file)
        ld      (hl), e
        inc     hl
        ld      (hl), d
        ld      hl, msg_ok
        call    C_PRTMSG
        ld      hl, (total_file)
        call    print_dec
        call    C_CRLF
        ret

drv_banner: db  "SCC - Small-C COMPILER", 13, 10, 0

; the stage-1 stub image (generated by build.sh from
; reloc-stage2/build/stub-template.bin)
stubimg:
        include "stub.inc"

; find_free: HL = first free directory entry, or carry.
find_free:
        ld      hl, DIRBUF + 16
        ld      b, 15
ff_lp:
        ld      a, (hl)
        or      a
        jr      z, ff_ok
        ld      de, 16
        add     hl, de
        djnz    ff_lp
        scf
        ret
ff_ok:
        or      a
        ret

; save_file: write (sv_len) bytes from (sv_addr) to the
; file named (find_name), recording load address (sv_load).
; Reuses an existing entry when the new image fits the old
; record count, else frees it and appends at next-free
; (the shell/EDAS allocation policy, as in NEWASM).
save_file:
        call    dir_load
        ld      hl, (sv_len)
        ld      de, 255
        add     hl, de
        ld      l, h
        ld      h, 0                    ; HL = records needed
        ld      (sv_need), hl
        ld      hl, name_out
        ld      (find_name), hl
        call    find_entry
        jr      c, sv_new
        ld      (sv_entry), hl
        ld      de, 12
        add     hl, de
        ld      e, (hl)
        inc     hl
        ld      d, (hl)                 ; DE = old size
        ld      hl, 255
        add     hl, de
        ld      l, h
        ld      h, 0                    ; HL = old record count
        ld      de, (sv_need)
        or      a
        sbc     hl, de
        jr      c, sv_grow              ; old < needed: append
        ld      hl, (sv_entry)
        ld      de, 10
        add     hl, de
        ld      e, (hl)
        inc     hl
        ld      d, (hl)
        ld      (sv_rec), de            ; reuse old start
        jr      sv_write
sv_grow:
        ld      hl, (sv_entry)
        ld      (hl), 0                 ; free the old entry
        call    find_free
        jp      c, sv_dirfull
        ld      (sv_entry), hl
        jp      sv_alloc
sv_new:
        call    find_free
        jp      c, sv_dirfull
        ld      (sv_entry), hl
sv_alloc:
        ld      hl, (DIRBUF + 6)        ; next free record
        ld      (sv_rec), hl
        ld      de, (sv_need)
        add     hl, de
        ld      de, FDMAXREC
        or      a
        sbc     hl, de
        jp      nc, sv_diskfull
        ld      hl, (sv_rec)
        ld      de, (sv_need)
        add     hl, de
        ld      (DIRBUF + 6), hl        ; advance next-free
sv_write:
        ld      hl, (sv_rec)
        ld      (sv_cur), hl
        ld      hl, (sv_addr)
        ld      (sv_ptr), hl
        ld      hl, (sv_need)
        ld      (sv_left), hl           ; record counter
sv_wlp:
        ld      hl, (sv_left)
        ld      a, h
        or      l
        jr      z, sv_done
        dec     hl
        ld      (sv_left), hl
        ld      de, (sv_cur)
        ld      hl, (sv_ptr)
        call    C_DWRITE
        ld      hl, (sv_cur)
        inc     hl
        ld      (sv_cur), hl
        ld      hl, (sv_ptr)
        ld      de, 256
        add     hl, de
        ld      (sv_ptr), hl
        jr      sv_wlp
sv_done:
        ; fill the entry: name, start, size, load address
        ld      hl, (sv_entry)
        ld      de, name_out
        ld      b, 10
sv_nm:
        ld      a, (de)
        ld      (hl), a
        inc     hl
        inc     de
        djnz    sv_nm
        ld      de, (sv_rec)
        ld      (hl), e
        inc     hl
        ld      (hl), d
        inc     hl
        ld      de, (sv_len)
        ld      (hl), e
        inc     hl
        ld      (hl), d
        inc     hl
        ld      de, (sv_load)
        ld      (hl), e
        inc     hl
        ld      (hl), d
        ld      de, DIRREC
        ld      hl, DIRBUF
        jp      C_DWRITE
sv_dirfull:
        ld      a, E_FILE
        jp      err
sv_diskfull:
        ld      a, E_BIG
        jp      err


; ---------------------------------------------------------------
; Emit pass setup: clear the bitmap, copy the stub.
; ---------------------------------------------------------------
emit_setup:
        ld      hl, BITMAP
        ld      de, BITMAP + 1
        ld      bc, 09ffh
        ld      (hl), 0
        ldir
        ld      hl, stubimg
        ld      de, ORIGIN
        ld      bc, STUB_LEN
        ldir
        ret


; ---------------------------------------------------------------
; emit_finish: append the bitmap and the TOSR trailer,
; compute the checksum, and save the file.
; ---------------------------------------------------------------
emit_finish:
        ; bitmap -> ORIGIN + rt_stub + bodysize
        ld      hl, BITMAP
        push    hl
        ld      hl, (bodysize)
        ld      de, (rt_stub)
        add     hl, de
        ld      de, (outbase_v)
        add     hl, de
        ex      de, hl                  ; DE = dest
        pop     hl                      ; HL = BITMAP
        ld      bc, (bitmap_size)
        ldir
        ; trailer at ORIGIN + rt_stub + bodysize + bitmap_size
        ld      hl, (bodysize)
        ld      de, (bitmap_size)
        add     hl, de
        ld      de, (rt_stub)
        add     hl, de
        ld      de, (outbase_v)
        add     hl, de
        ld      (ef_tr), hl
        ld      (hl), 'T'
        inc     hl
        ld      (hl), 'R'
        inc     hl
        ld      (hl), 1                 ; version
        inc     hl
        ld      (hl), 6                 ; flags: stub + entry
        inc     hl
        ld      (hl), 080h              ; origin page
        inc     hl
        ld      de, STUB_LEN            ; entry offset
        ld      (hl), e
        inc     hl
        ld      (hl), d
        inc     hl
        ld      de, (heap_blocks)
        ld      (hl), e                 ; heap blocks: ONE byte
        inc     hl
        ; body size in the trailer counts the stub too
        ; (mktosr.py / hostref.py convention)
        push    hl
        ld      hl, (bodysize)
        ld      de, (rt_stub)
        add     hl, de
        ex      de, hl
        pop     hl
        ld      (hl), e
        inc     hl
        ld      (hl), d
        inc     hl
        ld      de, (bitmap_size)
        ld      (hl), e
        inc     hl
        ld      (hl), d
        inc     hl
        ld      (hl), 0                 ; ext size = 0
        inc     hl
        ld      (hl), 0
        inc     hl
        ld      (ef_ck), hl             ; checksum field
        ; patch the stub immediates (hostref.py: total-16
        ; at +7, total-2 at +24, origin page at +62, body
        ; size (stub included) at +70 and +77)
        ld      hl, (total_file)
        ld      de, -16
        add     hl, de
        ld      (ef_val), hl
        ld      de, 7
        call    ef_patchw
        ld      hl, (total_file)
        dec     hl
        dec     hl
        ld      (ef_val), hl
        ld      de, 24
        call    ef_patchw
        ld      hl, (outbase_v)
        ld      de, 62
        add     hl, de
        ld      (hl), 080h
        ld      hl, (bodysize)
        ld      de, (rt_stub)
        add     hl, de
        ld      (ef_val), hl
        ld      de, 70
        call    ef_patchw
        ld      de, 77
        call    ef_patchw
        ; checksum: the stub sums the whole image (stub
        ; included) except the last two bytes.
        ld      hl, (total_file)
        dec     hl
        dec     hl
        ex      de, hl                  ; DE = byte count
        ld      hl, (outbase_v)         ; HL = file base
        ld      bc, 0                   ; sum in BC
ef_cklp:
        ld      a, (hl)
        add     a, c
        ld      c, a
        jr      nc, ef_ckn
        inc     b
ef_ckn:
        inc     hl
        dec     de
        ld      a, d
        or      e
        jr      nz, ef_cklp
        ld      hl, (ef_ck)
        ld      (hl), c
        inc     hl
        ld      (hl), b
        ret

; ef_patchw: store (ef_val) at (outbase_v) + DE.
ef_patchw:
        ld      hl, (outbase_v)
        add     hl, de
        ld      de, (ef_val)
        ld      (hl), e
        inc     hl
        ld      (hl), d
        ret


        end
