; Kill buffer geometry (EMM 01c000h, 8 KB).
KILLSIZE        equ     8192
; --- MCED variables: fixed addresses, NOT part of the
; loaded file (the same device as DIRBUF / FL1 / LA1).
; Persistent ones (kill buffer length, undo region,
; search string length, prefix state) live at 07e90h,
; right after SRCHBUF; transient per-command scratch
; lives at 07ea0h, ~220 bytes below the stack top.
kill_len        equ     07e90h          ; u16
lastkill        equ     07e92h
srch_len        equ     07e93h
pfx_on          equ     07e94h
pfx_cnt         equ     07e95h          ; u16
urg_n           equ     07e97h          ; u16
urg_ll          equ     07e99h
key2            equ     07e9ah
ek_cnt          equ     07e9bh          ; u16
ek_rep          equ     07e9dh
; transient scratch from 07ea0h
er_prompt       equ     07ea0h          ; u16
er_max          equ     07ea2h
er_ch           equ     07ea3h
ed_plen         equ     07ea4h
pr_src          equ     07ea5h          ; u16
pr_off          equ     07ea7h          ; u16
ka_src          equ     07ea9h          ; u16
ka_len          equ     07eabh
ka_off          equ     07each          ; u16
ka_nl           equ     07eaeh
kbl_src         equ     07eafh          ; u16
kbl_dst         equ     07eb1h          ; u16
kbl_off         equ     07eb3h          ; u16
kbl_cnt         equ     07eb5h          ; u16
krd_next        equ     07eb7h          ; u16
krd_cpos        equ     07eb9h
krd_clen        equ     07ebah
krd_ch          equ     07ebbh
krd_eof         equ     07ebch
ks_ch           equ     07ebdh
rg_l1           equ     07ebeh          ; u16
rg_c1           equ     07ec0h
rg_l2           equ     07ec1h          ; u16
rg_c2           equ     07ec3h
rg_save         equ     07ec4h
krc_i           equ     07ec5h          ; u16
krc_len         equ     07ec7h
krc_s           equ     07ec8h
krc_e           equ     07ec9h
krc_h           equ     07ecah
krc_t           equ     07ecbh
krc_cnt         equ     07ecch          ; u16
y_line          equ     07eceh          ; u16
y_col           equ     07ed0h
y_n             equ     07ed1h          ; u16
y_s0            equ     07ed3h
y_sn            equ     07ed4h
y_cur           equ     07ed5h
y_llen          equ     07ed6h
y_tail          equ     07ed7h
y_i             equ     07ed8h          ; u16
y_tgt           equ     07edah          ; u16
y_seglen        equ     07edch
y_ch            equ     07eddh
srch_dir        equ     07edeh
sc_l            equ     07edfh          ; u16
sc_end          equ     07ee1h          ; u16
sc_from         equ     07ee3h
sc_len          equ     07ee4h
sc_maxs         equ     07ee5h
sc_s            equ     07ee6h
sc_limline      equ     07ee7h          ; u16
sc_lim          equ     07ee9h
sc_lastmode     equ     07eeah
sc_found        equ     07eebh
sc_fl           equ     07eech          ; u16
sc_fs           equ     07eeeh
pg_cnt          equ     07eefh
lb_state        equ     07ef0h          ; u16
lb_num          equ     07ef2h
lb_row          equ     07ef3h
del_pos         equ     07ef4h
rfm_mk          equ     07ef5h          ; u16
tf_key          equ     07ef7h
ek_hdl          equ     07ef8h          ; u16
kbl_dir         equ     07efah
pr_row          equ     07efbh
kpc_buf         equ     07efch

