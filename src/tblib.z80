; tblib.z80 -- TinyBASIC runtime + external function library (X1).
;
; This file is NOT a standalone program. It is assembled twice
; by tools/mklibtab.py (ORG 0 and ORG 04000h); the byte diff of
; the two assemblies identifies every self-referential operand
; (an address inside the same routine), and the result is
; embedded into the compiler (TBC) as data tables (libtab.inc).
; TBC copies the routines a program actually uses into the
; output module and patches all references (see tinybasic.md).
;
; Two routine classes:
;   - runtime (register convention): inputs in DE and HL,
;     result in HL, clobber AF and DE (BC preserved). Called
;     directly by generated code.
;   - external (stack convention, same as user functions):
;     the caller pushes 16-bit argument slots in source
;     order (arg1 first, argN last) and CALLs; the routine
;     builds an IY frame (argN at (IY+4), arg1 at
;     (IY + 4 + 2*(nargs-1))), returns the result in HL,
;     and the caller cleans the stack.
;     IX (the heap base of the running program) is preserved.
;
; Routines refer to each other ONLY through the X_ dummy
; equates below (0C000h + 3*id). The compiler detects those
; operand values in the templates and rewrites them to the
; final addresses. Absolute constants (IOCS entries) are
; written literally. Internal branches use JR where possible;
; any remaining absolute self-reference is found by the
; two-origin diff.
;
; Routine ids (also the X_ dummy order):
;   0 rt_mul    1 rt_div    2 rt_mod    3 rt_shl    4 rt_shr
;   5 x_prints  6 x_printi  7 x_printnl 8 x_input   9 x_locate
;  10 x_cls    11 x_inkey  12 x_stick  13 x_vsync  14 x_peek
;  15 x_poke   16 x_putc   17 neg_hl   18 rtd_setup
;  19 udiv_core
;  20 x_seval  21 x_scall  22 x_scmload 23 x_scmerr
; (20-23: the embedded Tiny Scheme gate, roadmap id 61;
; see scheme-call.md.  The language functions are SEVAL /
; SCALL / SCMERR in the compiler's external table.)
; Every routine is self-contained: cross-routine references
; go through the X_ dummies only, never by label or by a
; relative branch into another routine.

C_INKEY         equ     0e400h          ; IOCS 0
C_CONOUT        equ     0e406h          ; IOCS 2
C_PRTMSG        equ     0e409h          ; IOCS 3
C_CRLF          equ     0e40ch          ; IOCS 4
C_GETLIN        equ     0e40fh          ; IOCS 5
C_CLRSCR        equ     0e412h          ; IOCS 6
C_LOCATE        equ     0e415h          ; IOCS 7
C_DREAD         equ     0e42dh          ; IOCS 15

X_RT_MUL        equ     0c000h
X_RT_DIV        equ     0c003h
X_RT_MOD        equ     0c006h
X_RT_SHL        equ     0c009h
X_RT_SHR        equ     0c00ch
X_PRINTS        equ     0c00fh
X_PRINTI        equ     0c012h
X_PRINTNL       equ     0c015h
X_INPUT         equ     0c018h
X_LOCATE        equ     0c01bh
X_CLS           equ     0c01eh
X_INKEY         equ     0c021h
X_STICK         equ     0c024h
X_VSYNC         equ     0c027h
X_PEEK          equ     0c02ah
X_POKE          equ     0c02dh
X_PUTC          equ     0c030h
X_NEGHL         equ     0c033h
X_RTD_SETUP     equ     0c036h
X_UDIV_CORE     equ     0c039h
X_SCMEVAL       equ     0c03ch
X_SCMC          equ     0c03fh
X_SCMLOAD       equ     0c042h
X_SCMERR        equ     0c045h

        org     __ORG__

; ---------------------------------------------------------------
; 0: rt_mul -- HL = DE * HL (low 16 bits; sign-agnostic)
; ---------------------------------------------------------------
RTB_00:
        push    bc
        ld      c, l
        ld      b, h                    ; BC = multiplier
        ld      hl, 0
        ld      a, 16
rtm_lp:
        srl     b
        rr      c
        jr      nc, rtm_no
        add     hl, de
rtm_no:
        sla     e
        rl      d
        dec     a
        jr      nz, rtm_lp
        pop     bc
        ret

; ---------------------------------------------------------------
; 1: rt_div -- HL = DE / HL (signed, C semantics);
;    division by zero yields 0.
; 2: rt_mod -- HL = DE % HL (signed, sign of dividend);
;    division by zero yields 0.
; Shared core: udiv_core takes BC = divisor (unsigned,
; nonzero), DE = dividend (unsigned); returns quotient in
; DE, remainder in HL.
; ---------------------------------------------------------------
RTB_01:
        call    X_RTD_SETUP             ; CF=1: divisor was 0
        jr      c, rtdz_1
        push    af                      ; udiv_core clobbers A
        call    X_UDIV_CORE             ; DE=quot, HL=rem
        pop     af
        ex      de, hl                  ; HL = quotient
        or      a
        ret     p                       ; combined sign positive
        jp      X_NEGHL
rtdz_1:
        ld      hl, 0
        ret

RTB_02:
        call    X_RTD_SETUP
        jr      c, rtdz_2
        push    af                      ; udiv_core clobbers A
        call    X_UDIV_CORE             ; HL = remainder
        pop     af
        bit     6, a                    ; dividend sign
        ret     z
        jp      X_NEGHL
rtdz_2:
        ld      hl, 0
        ret

; ---------------------------------------------------------------
; 3: rt_shl -- HL = DE << (HL & 15)
; 4: rt_shr -- HL = DE >> (HL & 15), arithmetic
; ---------------------------------------------------------------
RTB_03:
        ld      a, l
        and     015
        ld      h, d
        ld      l, e                    ; HL = value
        ret     z
        ld      b, a
rsl_lp:
        add     hl, hl
        djnz    rsl_lp
        ret

RTB_04:
        ld      a, l
        and     015
        ld      h, d
        ld      l, e                    ; HL = value
        ret     z
        ld      b, a
rsr_lp:
        sra     h
        rr      l
        djnz    rsr_lp
        ret

; ---------------------------------------------------------------
; 5: x_prints -- print(arg1): NUL-terminated string at arg1.
; ---------------------------------------------------------------
RTB_05:
        push    iy
        ld      iy, 0
        add     iy, sp
        ld      l, (iy + 4)
        ld      h, (iy + 5)
        call    C_PRTMSG
        ld      hl, 0
        pop     iy
        ret

; ---------------------------------------------------------------
; 6: x_printi -- print(arg1): signed decimal, no newline.
; ---------------------------------------------------------------
RTB_06:
        push    iy
        ld      iy, 0
        add     iy, sp
        ld      l, (iy + 4)
        ld      h, (iy + 5)
        bit     7, h
        jr      z, xpi_pos
        ld      a, '-'
        call    C_CONOUT
        call    X_NEGHL
xpi_pos:
        ld      de, xpi_buf             ; self-ref (diff)
        ld      c, 0                    ; digit count
xpi_lp:
        push    de
        push    bc
        ex      de, hl                  ; DE = value
        ld      hl, 10
        call    X_RT_DIV                ; HL = quot, DE = rem
        ld      a, e                    ; remainder (before pops!)
        pop     bc
        pop     de
        add     a, '0'
        ld      (de), a                 ; least significant first
        inc     de
        inc     c
        ld      a, h
        or      l
        jr      nz, xpi_lp
xpi_out:
        dec     de
        ld      a, (de)
        call    C_CONOUT
        dec     c
        jr      nz, xpi_out
        ld      hl, 0
        pop     iy
        ret
xpi_buf:
        defs    6

; ---------------------------------------------------------------
; 7: x_printnl -- print(): newline (CRLF).
; ---------------------------------------------------------------
RTB_07:
        call    C_CRLF
        ld      hl, 0
        ret

; ---------------------------------------------------------------
; 8: x_input -- input(): read a line, parse a signed decimal,
; return it. No digits -> 0.
; ---------------------------------------------------------------
RTB_08:
        ld      hl, xin_buf             ; self-ref (diff)
        ld      b, 80
        call    C_GETLIN                ; A = length (unused)
        ld      hl, xin_buf
        xor     a
        ld      (xin_sign), a           ; self-ref (diff)
        ld      a, (hl)
        cp      '-'
        jr      nz, xin_num
        ld      a, 1
        ld      (xin_sign), a
        inc     hl
xin_num:
        ld      bc, 0                   ; value in BC
xin_lp:
        ld      a, (hl)
        sub     '0'
        jr      c, xin_done
        cp      10
        jr      nc, xin_done
        inc     hl
        push    hl                      ; text pointer
        ld      l, a
        ld      h, 0
        push    hl                      ; digit
        ld      l, c
        ld      h, b                    ; HL = value
        add     hl, hl                  ; *2
        ld      d, h
        ld      e, l                    ; DE = *2
        add     hl, hl                  ; *4
        add     hl, hl                  ; *8
        add     hl, de                  ; *10
        pop     de                      ; digit
        add     hl, de
        ld      c, l
        ld      b, h                    ; BC = new value
        pop     hl                      ; text pointer
        jr      xin_lp
xin_done:
        ld      l, c
        ld      h, b
        ld      a, (xin_sign)           ; self-ref (diff)
        or      a
        ret     z
        jp      X_NEGHL
xin_sign:
        defb    0
xin_buf:
        defs    82

; ---------------------------------------------------------------
; 9: x_locate -- locate(x, y): IOCS LOCATE (H = x, L = y).
; With 2 args pushed in source order, y is at (IY+4) and
; x at (IY+6).
; ---------------------------------------------------------------
RTB_09:
        push    iy
        ld      iy, 0
        add     iy, sp
        ld      h, (iy + 6)             ; x (low byte)
        ld      l, (iy + 4)             ; y (low byte)
        call    C_LOCATE
        ld      hl, 0
        pop     iy
        ret

; ---------------------------------------------------------------
; 10: x_cls -- cls(): clear screen.
; ---------------------------------------------------------------
RTB_10:
        call    C_CLRSCR
        ld      hl, 0
        ret

; ---------------------------------------------------------------
; 11: x_inkey -- inkey(): code of the key currently down,
; 0 if none (IOCS INKEY, non-blocking).
; ---------------------------------------------------------------
RTB_11:
        call    C_INKEY
        ld      l, a
        ld      h, 0
        ret

; ---------------------------------------------------------------
; 12: x_stick -- stick(): direction of the "stick", read from
; the keyboard (the X1 has no joystick port in this setup).
;   0 = none, 1 = up, 2 = down, 3 = left, 4 = right.
; Keys: 8/2/4/6 (numpad style), I/K/J/L, W/S/A/D (either case).
; Diagonals cannot occur: INKEY reports one key at a time.
; ---------------------------------------------------------------
RTB_12:
        call    C_INKEY
        ld      hl, 0
        cp      '8'
        jr      z, xst_up
        cp      'I'
        jr      z, xst_up
        cp      'i'
        jr      z, xst_up
        cp      'W'
        jr      z, xst_up
        cp      'w'
        jr      z, xst_up
        cp      '2'
        jr      z, xst_dn
        cp      'K'
        jr      z, xst_dn
        cp      'k'
        jr      z, xst_dn
        cp      'S'
        jr      z, xst_dn
        cp      's'
        jr      z, xst_dn
        cp      '4'
        jr      z, xst_lf
        cp      'J'
        jr      z, xst_lf
        cp      'j'
        jr      z, xst_lf
        cp      'A'
        jr      z, xst_lf
        cp      'a'
        jr      z, xst_lf
        cp      '6'
        jr      z, xst_rt
        cp      'L'
        jr      z, xst_rt
        cp      'l'
        jr      z, xst_rt
        cp      'D'
        jr      z, xst_rt
        cp      'd'
        jr      z, xst_rt
        ret
xst_up:
        ld      l, 1
        ret
xst_dn:
        ld      l, 2
        ret
xst_lf:
        ld      l, 3
        ret
xst_rt:
        ld      l, 4
        ret

; ---------------------------------------------------------------
; 13: x_vsync -- vsync(): frame pacing, about 1/60 s.
; The stock X1 exposes no guest-readable vertical-sync
; signal (in the novel, wiring the CRTC V-Sync into a Z80
; CTC is a hardware mod of its own), so this is a calibrated
; busy wait. VSYNC_N is tuned against the emulator's frame
; clock during the sample sessions (see tinybasic.md).
; ---------------------------------------------------------------
VSYNC_N         equ     2560
RTB_13:
        push    bc
        ld      bc, VSYNC_N
xvs_lp:
        dec     bc
        ld      a, b
        or      c
        jr      nz, xvs_lp
        pop     bc
        ld      hl, 0
        ret

; ---------------------------------------------------------------
; 14: x_peek -- peek(addr): byte at addr, zero-extended.
; ---------------------------------------------------------------
RTB_14:
        push    iy
        ld      iy, 0
        add     iy, sp
        ld      l, (iy + 4)
        ld      h, (iy + 5)
        ld      a, (hl)
        ld      l, a
        ld      h, 0
        pop     iy
        ret

; ---------------------------------------------------------------
; 15: x_poke -- poke(addr, value): store a byte.
; addr is at (IY+6), value at (IY+4).
; ---------------------------------------------------------------
RTB_15:
        push    iy
        ld      iy, 0
        add     iy, sp
        ld      l, (iy + 6)
        ld      h, (iy + 7)
        ld      a, (iy + 4)
        ld      (hl), a
        ld      hl, 0
        pop     iy
        ret

; ---------------------------------------------------------------
; 16: x_putc -- putc(c): write one character (IOCS CONOUT).
; ---------------------------------------------------------------
RTB_16:
        push    iy
        ld      iy, 0
        add     iy, sp
        ld      a, (iy + 4)
        call    C_CONOUT
        ld      hl, 0
        pop     iy
        ret

; ---------------------------------------------------------------
; 17: neg_hl -- HL = -HL (preserves BC, DE; clobbers A).
; ---------------------------------------------------------------
RTB_17:
        xor     a
        sub     l
        ld      l, a
        sbc     a, a
        sub     h
        ld      h, a
        ret

; ---------------------------------------------------------------
; 18: rtd_setup -- signed divide setup for rt_div / rt_mod.
; In: DE = dividend, HL = divisor.
;   divisor == 0 -> carry set (callers return 0).
;   else BC = |divisor|, DE = |dividend|, carry clear,
;   A bit7 = sign(dividend) XOR sign(divisor),
;   A bit6 = sign(dividend).
; ---------------------------------------------------------------
RTB_18:
        ld      a, h
        or      l
        scf
        ret     z                       ; divisor 0: carry
        ld      a, d
        xor     h
        and     080h
        push    af                      ; combined sign (bit7)
        ld      a, d
        and     080h
        rrca                            ; dividend sign -> bit6
        ld      c, a
        pop     af
        or      c                       ; A = both sign bits
        push    af
        bit     7, h
        jr      z, rtd_hpos
        call    X_NEGHL                 ; HL = |divisor|
rtd_hpos:
        ld      c, l
        ld      b, h                    ; BC = |divisor|
        bit     7, d
        jr      z, rtd_dpos
        ex      de, hl
        call    X_NEGHL
        ex      de, hl                  ; DE = |dividend|
rtd_dpos:
        pop     af
        or      a                       ; clear carry
        ret

; ---------------------------------------------------------------
; 19: udiv_core -- BC = divisor (unsigned, nonzero),
; DE = dividend (unsigned) -> DE = quotient, HL = remainder.
; ---------------------------------------------------------------
RTB_19:
        ld      hl, 0                   ; remainder
        ld      a, 16
udc_lp:
        sla     e
        rl      d                       ; dividend <<= 1, bit -> carry
        adc     hl, hl                  ; remainder = rem*2 + carry
        push    hl
        or      a
        sbc     hl, bc
        jr      nc, udc_ok
        pop     hl                      ; too big: restore remainder
        jr      udc_nx
udc_ok:
        inc     sp
        inc     sp                      ; discard saved remainder
        inc     de                      ; quotient bit = 1
udc_nx:
        dec     a
        jr      nz, udc_lp
        ret

; ---------------------------------------------------------------
; 20: x_seval -- SEVAL(text): evaluate the NUL-terminated
; Scheme text through the embedded core's gate and return
; the result converted to an int.  Errors (and a missing
; core) return 0; SCMERR distinguishes.  The gate entry is
; the fixed header at 09000h (see scheme-call.md).
; ---------------------------------------------------------------
RTB_20:
        push    iy
        ld      iy, 0
        add     iy, sp
        ld      a, (09000h)
        cp      'S'
        jr      nz, xse_none
        ld      a, (09001h)
        cp      'C'
        jr      nz, xse_none
        ld      l, (iy + 4)
        ld      h, (iy + 5)             ; HL = text pointer
        call    09007h                  ; gate_eval
        jr      nc, xse_ok
xse_none:
        ld      hl, 0
xse_ok:
        pop     iy
        ret
        ; dependency anchor: this word is registered by
        ; mklibtab as a reference to x_scmload (22), so the
        ; layout closure includes the loader whenever this
        ; routine is used.  Never executed.
        dw      X_SCMLOAD

; ---------------------------------------------------------------
; 21: x_scall -- SCALL(name, ...): call a Scheme procedure
; by name with int arguments (at most 8; the gate enforces
; it) and return its value converted to int.  Variadic
; like PRINT: the code generator loads A with the number
; of int arguments (after the name) before the CALL and
; cleans the stack itself.  Argument slots lie at (IY+4)
; last-first -- exactly the gate's argv order -- so the
; gate reads them in place.  Errors and a missing core
; return 0.
; ---------------------------------------------------------------
RTB_21:
        push    iy
        ld      iy, 0
        add     iy, sp
        ld      b, a                    ; B = int argument count
        ld      a, (09000h)
        cp      'S'
        jr      nz, xsc_none
        ld      a, (09001h)
        cp      'C'
        jr      nz, xsc_none
        ld      l, b
        ld      h, 0
        add     hl, hl                  ; HL = 2 * count
        ld      de, 4
        add     hl, de                  ; HL = 4 + 2 * count
        push    iy
        pop     de
        add     hl, de                  ; HL = &name slot
        ld      e, (hl)
        inc     hl
        ld      d, (hl)                 ; DE = name pointer (temp)
        ld      c, b
        ld      b, 0                    ; BC = argc (before BC
        push    bc                      ; is used as scratch)
        push    de                      ; name pointer aside
        push    iy
        pop     hl
        ld      de, 4
        add     hl, de                  ; HL = argv (IY + 4)
        pop     de                      ; DE = name pointer
        ex      de, hl                  ; HL = name, DE = argv
        pop     bc                      ; BC = argc
        call    0900ah                  ; gate_call
        jr      nc, xsc_ok
xsc_none:
        ld      hl, 0
xsc_ok:
        pop     iy
        ret
        ; dependency anchor (see x_seval): -> x_scmload.
        dw      X_SCMLOAD

; ---------------------------------------------------------------
; 22: x_scmload -- load the embedded Tiny Scheme core
; (the TOSD file "SCMCORE") from the current disk into
; 09000h and initialise it through its gate.  No
; arguments: the runtime entry calls it once when the
; program uses SEVAL/SCALL (their dependency anchors pull
; it in).  A missing file or a bad image is not an error
; here: the magic stays clear and SCMERR reports 0fbh.
; The records are read straight into the core area (the
; tail of the last record lands in the not-yet-initialised
; arena and is reset by gate_init).  Uses DIRBUF (06800h).
; ---------------------------------------------------------------
RTB_22:
        xor     a
        ld      (09000h), a             ; clear any stale magic
        ld      (09001h), a
        ld      de, 32                  ; directory record
        ld      hl, 06800h              ; DIRBUF (tbcore map)
        call    C_DREAD
        ld      hl, 06800h + 16
        ld      b, 15
xsl_lp:
        ld      a, (hl)
        or      a
        jr      z, xsl_nx
        push    hl
        push    bc
        ld      de, xsl_name            ; self-ref (diff)
        ld      b, 10
xsl_cmp:
        ld      a, (de)
        cp      (hl)
        jr      nz, xsl_dif
        inc     hl
        inc     de
        djnz    xsl_cmp
        pop     bc
        pop     hl
        jr      xsl_fd
xsl_dif:
        pop     bc
        pop     hl
xsl_nx:
        ld      de, 16
        add     hl, de
        djnz    xsl_lp
        ret                             ; not found
xsl_fd:
        ld      de, 10
        add     hl, de
        ld      e, (hl)
        inc     hl
        ld      d, (hl)                 ; DE = first record
        inc     hl
        ld      c, (hl)
        inc     hl
        ld      b, (hl)                 ; BC = size in bytes
        ld      a, c
        or      a
        ld      a, b
        jr      z, xsl_nc
        inc     a                       ; A = record count
xsl_nc:
        ld      b, a
        ld      hl, 09000h              ; destination
xsl_rd:
        push    bc
        push    de
        push    hl
        call    C_DREAD                 ; DE = record, HL = dest
        pop     hl
        pop     de
        pop     bc
        inc     de                      ; next record
        inc     h                       ; dest += 256
        djnz    xsl_rd
        ld      a, (09000h)
        cp      'S'
        ret     nz
        ld      a, (09001h)
        cp      'C'
        ret     nz
        jp      09004h                  ; gate_init (tail call)
xsl_name:
        defb    "SCMCORE   "

; ---------------------------------------------------------------
; 23: x_scmerr -- SCMERR(): the embedded core's last error
; code (0 = OK, 1..10 = the Scheme E_* codes, 0fbh = core
; not loaded, 0fch = an argument outside the fixnum
; range, 0fdh = result not convertible).
; ---------------------------------------------------------------
RTB_23:
        ld      a, (09000h)
        cp      'S'
        jr      nz, xsr_none
        ld      a, (09001h)
        cp      'C'
        jr      nz, xsr_none
        ld      a, (09003h)
        ld      l, a
        ld      h, 0
        ret
xsr_none:
        ld      hl, 0fbh
        ret

RTB_END:
        end
